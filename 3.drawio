<mxfile host="app.diagrams.net"><diagram id="7434-23" name="SQL – сите задачи (за Word)"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1878" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="7434-1" value="Сите SQL задачи (база School) – редослед 3.1 → 3.4, па 4.1 → 4.3" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#142027;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1100" height="36" as="geometry"/></mxCell><mxCell id="7434-2" value="3.1)  [3 Points]" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#142027;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="900" height="30" as="geometry"/></mxCell><mxCell id="7434-3" value="&lt;i&gt;Find all courses (title, credits) and Department name for each department and course where we have more than 3 credits.&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="78" width="900" height="45" as="geometry"/></mxCell><mxCell id="7434-4" value="&lt;pre style=&quot;margin:0;font-family:Courier New,monospace;font-size:12px;line-height:15px;text-align:left;white-space:pre&quot;&gt;SELECT c.Title, c.Credits, d.Name AS DepartmentName&#xa;FROM Course AS c&#xa;JOIN Department AS d ON d.DepartmentID = c.DepartmentID&#xa;WHERE c.Credits &amp;gt; 3;&lt;/pre&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;spacingLeft=10;spacingTop=6;fontColor=#142027;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="40" y="127" width="900" height="80" as="geometry"/></mxCell><mxCell id="7434-5" value="3.2)  [3 Points]" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#142027;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="241" width="900" height="30" as="geometry"/></mxCell><mxCell id="7434-6" value="&lt;i&gt;Insert 3 (three) new students in the table Person and 1 (one) new Instructor&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="277" width="900" height="45" as="geometry"/></mxCell><mxCell id="7434-7" value="&lt;pre style=&quot;margin:0;font-family:Courier New,monospace;font-size:12px;line-height:15px;text-align:left;white-space:pre&quot;&gt;INSERT INTO Person (LastName, FirstName, HireDate, EnrollmentDate, Discriminator)&#xa;VALUES (&amp;#x27;Petrovski&amp;#x27;, &amp;#x27;Marko&amp;#x27;, NULL, &amp;#x27;20241001&amp;#x27;, &amp;#x27;Student&amp;#x27;),&#xa;       (&amp;#x27;Nikolova&amp;#x27;,  &amp;#x27;Ana&amp;#x27;,   NULL, &amp;#x27;20241001&amp;#x27;, &amp;#x27;Student&amp;#x27;),&#xa;       (&amp;#x27;Trajkovski&amp;#x27;,&amp;#x27;Stefan&amp;#x27;,NULL, &amp;#x27;20241001&amp;#x27;, &amp;#x27;Student&amp;#x27;);&#xa;&#xa;INSERT INTO Person (LastName, FirstName, HireDate, EnrollmentDate, Discriminator)&#xa;VALUES (&amp;#x27;Stojanovski&amp;#x27;, &amp;#x27;Ivan&amp;#x27;, &amp;#x27;20240901&amp;#x27;, NULL, &amp;#x27;Instructor&amp;#x27;);&#xa;&#xa;SELECT * FROM Person WHERE PersonID &amp;gt; 34;&lt;/pre&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;spacingLeft=10;spacingTop=6;fontColor=#142027;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="40" y="326" width="900" height="155" as="geometry"/></mxCell><mxCell id="7434-8" value="3.3)  [4 Points]" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#142027;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="515" width="900" height="30" as="geometry"/></mxCell><mxCell id="7434-9" value="&lt;i&gt;Insert DB Course with 4 credits and ID 5011 from ICT department with budget of 500000 and start date 01-October-2024. Insert DDB Course with 6 credits and ID 5022 from ICT department with budget of 700000 and start date 01-February-2025. Show new records from the respective tables in DB.&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="551" width="900" height="87" as="geometry"/></mxCell><mxCell id="7434-10" value="&lt;pre style=&quot;margin:0;font-family:Courier New,monospace;font-size:12px;line-height:15px;text-align:left;white-space:pre&quot;&gt;INSERT INTO Department (DepartmentID, Name, Budget, StartDate, Administrator)&#xa;VALUES (10, &amp;#x27;ICT&amp;#x27;, 500000, &amp;#x27;20241001&amp;#x27;, NULL);&#xa;INSERT INTO Course (CourseID, Title, Credits, DepartmentID)&#xa;VALUES (5011, &amp;#x27;DB&amp;#x27;, 4, 10);&#xa;&#xa;INSERT INTO Department (DepartmentID, Name, Budget, StartDate, Administrator)&#xa;VALUES (11, &amp;#x27;ICT&amp;#x27;, 700000, &amp;#x27;20250201&amp;#x27;, NULL);&#xa;INSERT INTO Course (CourseID, Title, Credits, DepartmentID)&#xa;VALUES (5022, &amp;#x27;DDB&amp;#x27;, 6, 11);&#xa;&#xa;SELECT * FROM Department WHERE DepartmentID IN (10, 11);&#xa;SELECT * FROM Course WHERE CourseID IN (5011, 5022);&lt;/pre&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;spacingLeft=10;spacingTop=6;fontColor=#142027;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="40" y="642" width="900" height="200" as="geometry"/></mxCell><mxCell id="7434-11" value="3.4)  [1 Point]" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#142027;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="876" width="900" height="30" as="geometry"/></mxCell><mxCell id="7434-12" value="&lt;i&gt;Insert new CourseInstructor for DD and DDB.&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="912" width="900" height="45" as="geometry"/></mxCell><mxCell id="7434-13" value="&lt;pre style=&quot;margin:0;font-family:Courier New,monospace;font-size:12px;line-height:15px;text-align:left;white-space:pre&quot;&gt;INSERT INTO CourseInstructor (CourseID, PersonID)&#xa;SELECT 5011, PersonID FROM Person&#xa;WHERE FirstName = &amp;#x27;Ivan&amp;#x27; AND LastName = &amp;#x27;Stojanovski&amp;#x27; AND Discriminator = &amp;#x27;Instructor&amp;#x27;;&#xa;&#xa;INSERT INTO CourseInstructor (CourseID, PersonID)&#xa;SELECT 5022, PersonID FROM Person&#xa;WHERE FirstName = &amp;#x27;Ivan&amp;#x27; AND LastName = &amp;#x27;Stojanovski&amp;#x27; AND Discriminator = &amp;#x27;Instructor&amp;#x27;;&#xa;&#xa;SELECT * FROM CourseInstructor WHERE CourseID IN (5011, 5022);&lt;/pre&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;spacingLeft=10;spacingTop=6;fontColor=#142027;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="40" y="961" width="900" height="155" as="geometry"/></mxCell><mxCell id="7434-14" value="4.1)  [5 Points]" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#142027;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1150" width="900" height="30" as="geometry"/></mxCell><mxCell id="7434-15" value="&lt;i&gt;Find info for each student (First and Last Name, enrolment date), course name credits for the course and department name.&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="1186" width="900" height="45" as="geometry"/></mxCell><mxCell id="7434-16" value="&lt;pre style=&quot;margin:0;font-family:Courier New,monospace;font-size:12px;line-height:15px;text-align:left;white-space:pre&quot;&gt;SELECT p.FirstName, p.LastName, p.EnrollmentDate,&#xa;       c.Title AS CourseName, c.Credits, d.Name AS DepartmentName&#xa;FROM Person AS p&#xa;JOIN StudentGrade AS sg ON sg.StudentID = p.PersonID&#xa;JOIN Course AS c        ON c.CourseID = sg.CourseID&#xa;JOIN Department AS d    ON d.DepartmentID = c.DepartmentID&#xa;WHERE p.Discriminator = &amp;#x27;Student&amp;#x27;&#xa;ORDER BY p.LastName, p.FirstName;&lt;/pre&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;spacingLeft=10;spacingTop=6;fontColor=#142027;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="40" y="1235" width="900" height="140" as="geometry"/></mxCell><mxCell id="7434-17" value="4.2)  [6 Points]" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#142027;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1409" width="900" height="30" as="geometry"/></mxCell><mxCell id="7434-18" value="&lt;i&gt;Find the number of students per course. In the output we need to see number of students and course name.&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="1445" width="900" height="45" as="geometry"/></mxCell><mxCell id="7434-19" value="&lt;pre style=&quot;margin:0;font-family:Courier New,monospace;font-size:12px;line-height:15px;text-align:left;white-space:pre&quot;&gt;SELECT c.Title AS CourseName, COUNT(DISTINCT sg.StudentID) AS NumberOfStudents&#xa;FROM Course AS c&#xa;JOIN StudentGrade AS sg ON sg.CourseID = c.CourseID&#xa;GROUP BY c.Title&#xa;ORDER BY NumberOfStudents DESC;&lt;/pre&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;spacingLeft=10;spacingTop=6;fontColor=#142027;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="40" y="1494" width="900" height="95" as="geometry"/></mxCell><mxCell id="7434-20" value="4.3)  [6 Points]" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#142027;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1623" width="900" height="30" as="geometry"/></mxCell><mxCell id="7434-21" value="&lt;i&gt;Find the number of students per department. In the output we need to see number of students and department name.&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="1659" width="900" height="45" as="geometry"/></mxCell><mxCell id="7434-22" value="&lt;pre style=&quot;margin:0;font-family:Courier New,monospace;font-size:12px;line-height:15px;text-align:left;white-space:pre&quot;&gt;SELECT d.Name AS DepartmentName, COUNT(DISTINCT sg.StudentID) AS NumberOfStudents&#xa;FROM Department AS d&#xa;JOIN Course AS c        ON c.DepartmentID = d.DepartmentID&#xa;JOIN StudentGrade AS sg ON sg.CourseID = c.CourseID&#xa;GROUP BY d.Name&#xa;ORDER BY NumberOfStudents DESC;&lt;/pre&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;spacingLeft=10;spacingTop=6;fontColor=#142027;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="40" y="1708" width="900" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="1405-26" name="0 · Подготовка + School"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="1244" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="1405-1" value="0 · Подготовка: Restore на School" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#142027;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1000" height="36" as="geometry"/></mxCell><mxCell id="1405-2" value="&lt;div style=&quot;font-weight:bold;font-size:14px;margin:6px 0 2px 0;text-align:left&quot;&gt;Чекори&lt;/div&gt;&lt;ol style=&quot;margin:2px 0 6px 0;padding-left:20px;text-align:left&quot;&gt;&#xa;&lt;li style=&quot;margin:0 0 2px 0&quot;&gt;&lt;b&gt;Избриши ги сите бази.&lt;/b&gt; Во Object Explorer → Databases кликни десен клик на секоја база (без &lt;i&gt;System Databases&lt;/i&gt;), избери &lt;b&gt;Delete&lt;/b&gt;, штиклирај &lt;i&gt;Close existing connections&lt;/i&gt; и OK.&lt;/li&gt;&#xa;&lt;li style=&quot;margin:0 0 2px 0&quot;&gt;&lt;b&gt;Папка&lt;/b&gt; C:\DBPartTime062026. Во документот пишува „C:\ DBPartTime062026“ со празно место, но тоа е печатна грешка. Името е без празно место.&lt;/li&gt;&#xa;&lt;li style=&quot;margin:0 0 2px 0&quot;&gt;&lt;b&gt;Симни&lt;/b&gt; ги School.bak и DB_PartTime_03112026.docx од Moodle во таа папка.&lt;/li&gt;&#xa;&lt;li style=&quot;margin:0 0 2px 0&quot;&gt;&lt;b&gt;Restore.&lt;/b&gt; Десен клик на Databases → &lt;i&gt;Restore Database…&lt;/i&gt; → Source: &lt;b&gt;Device&lt;/b&gt; → … → Add → C:\DBPartTime062026\School.bak → OK. На страницата &lt;i&gt;Files&lt;/i&gt; штиклирај &lt;i&gt;Relocate all files to folder&lt;/i&gt;, па OK.&lt;/li&gt;&#xa;&lt;li style=&quot;margin:0 0 2px 0&quot;&gt;&lt;b&gt;Провери.&lt;/b&gt; New Query (Ctrl+N), горе избери ја базата &lt;b&gt;School&lt;/b&gt;, напиши SELECT COUNT(*) FROM Person; и притисни F5. Резултатот треба да е &lt;b&gt;34&lt;/b&gt;.&lt;/li&gt;&#xa;&lt;li style=&quot;margin:0 0 2px 0&quot;&gt;&lt;b&gt;Screenshot.&lt;/b&gt; Win+PrtScn ја зачувува сликата во &lt;i&gt;Pictures\Screenshots&lt;/i&gt;. Залепи ја во Word или преименувај ја (на пр. SQL1.png) и стави ја во папката.&lt;/li&gt;&lt;/ol&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="560" height="391" as="geometry"/></mxCell><mxCell id="1405-3" value="&lt;div style=&quot;font-weight:bold;font-size:14px;margin:6px 0 2px 0;text-align:left&quot;&gt;Ако избришеш или вратиш со T‑SQL&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="640" y="42" width="600" height="58" as="geometry"/></mxCell><mxCell id="1405-4" value="&lt;pre style=&quot;margin:0;font-family:Courier New,monospace;font-size:12px;line-height:15px;text-align:left;white-space:pre&quot;&gt;USE master;&#xa;ALTER DATABASE School SET SINGLE_USER WITH ROLLBACK IMMEDIATE;&#xa;DROP DATABASE School;  -- само корисничките бази, никогаш master/model/msdb/tempdb&lt;/pre&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;spacingLeft=10;spacingTop=6;fontColor=#142027;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="640" y="100" width="618" height="65" as="geometry"/></mxCell><mxCell id="1405-5" value="&lt;pre style=&quot;margin:0;font-family:Courier New,monospace;font-size:12px;line-height:15px;text-align:left;white-space:pre&quot;&gt;RESTORE FILELISTONLY FROM DISK = N&amp;#x27;C:\DBPartTime062026\School.bak&amp;#x27;;&#xa;-- логички имиња: School и School_log&#xa;RESTORE DATABASE School&#xa;FROM DISK = N&amp;#x27;C:\DBPartTime062026\School.bak&amp;#x27;&#xa;WITH MOVE &amp;#x27;School&amp;#x27;     TO N&amp;#x27;C:\Program Files\Microsoft SQL Server\MSSQL16.SQLEXPRESS\MSSQL\DATA\School.mdf&amp;#x27;,&#xa;     MOVE &amp;#x27;School_log&amp;#x27; TO N&amp;#x27;C:\Program Files\Microsoft SQL Server\MSSQL16.SQLEXPRESS\MSSQL\DATA\School_log.ldf&amp;#x27;,&#xa;     REPLACE, RECOVERY;&lt;/pre&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;spacingLeft=10;spacingTop=6;fontColor=#142027;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="640" y="175" width="836" height="125" as="geometry"/></mxCell><mxCell id="1405-6" value="&lt;span style=&#x27;color:#5b6b73&#x27;&gt;MSSQL16 е SQL Server 2022, а MSSQL15 е 2019. Провери ја вистинската DATA патека кај тебе. Бекапот е од 2019 (MSSQL15), па затоа GUI-то бара &lt;i&gt;Relocate&lt;/i&gt;.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="640" y="304" width="600" height="61" as="geometry"/></mxCell><mxCell id="1405-7" value="Табелите во School (стрелка = FK → PK)" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#142027;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="463" width="800" height="32" as="geometry"/></mxCell><mxCell id="1405-8" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot;&gt;&lt;tr&gt;&lt;th colspan=&quot;3&quot; style=&quot;background:#0b7a6b;color:#fff;padding:4px;font-size:12px&quot;&gt;Department&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 8px;white-space:nowrap;border-top:1px solid #e3e8e5&quot;&gt;&lt;u&gt;&lt;b&gt;DepartmentID&lt;/b&gt;&lt;/u&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 8px;color:#5b6b73;border-top:1px solid #e3e8e5&quot;&gt;INT&lt;/td&gt;&lt;td style=&quot;padding:2px 8px;color:#0b7a6b;font-weight:bold;border-top:1px solid #e3e8e5&quot;&gt;PK&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 8px;white-space:nowrap;border-top:1px solid #e3e8e5&quot;&gt;Name&lt;/td&gt;&lt;td style=&quot;padding:2px 8px;color:#5b6b73;border-top:1px solid #e3e8e5&quot;&gt;NVARCHAR(50)&lt;/td&gt;&lt;td style=&quot;padding:2px 8px;color:#0b7a6b;font-weight:bold;border-top:1px solid #e3e8e5&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 8px;white-space:nowrap;border-top:1px solid #e3e8e5&quot;&gt;Budget&lt;/td&gt;&lt;td style=&quot;padding:2px 8px;color:#5b6b73;border-top:1px solid #e3e8e5&quot;&gt;MONEY&lt;/td&gt;&lt;td style=&quot;padding:2px 8px;color:#0b7a6b;font-weight:bold;border-top:1px solid #e3e8e5&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 8px;white-space:nowrap;border-top:1px solid #e3e8e5&quot;&gt;StartDate&lt;/td&gt;&lt;td style=&quot;padding:2px 8px;color:#5b6b73;border-top:1px solid #e3e8e5&quot;&gt;DATETIME&lt;/td&gt;&lt;td style=&quot;padding:2px 8px;color:#0b7a6b;font-weight:bold;border-top:1px solid #e3e8e5&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 8px;white-space:nowrap;border-top:1px solid #e3e8e5&quot;&gt;Administrator&lt;/td&gt;&lt;td style=&quot;padding:2px 8px;color:#5b6b73;border-top:1px solid #e3e8e5&quot;&gt;INT&lt;/td&gt;&lt;td style=&quot;padding:2px 8px;color:#0b7a6b;font-weight:bold;border-top:1px solid #e3e8e5&quot;&gt;NULL&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;overflow=fill;fillColor=#ffffff;strokeColor=#142027;verticalAlign=top;align=left;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="501" width="263" height="123" as="geometry"/></mxCell><mxCell id="1405-9" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot;&gt;&lt;tr&gt;&lt;th colspan=&quot;3&quot; style=&quot;background:#0b7a6b;color:#fff;padding:4px;font-size:12px&quot;&gt;Course&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 8px;white-space:nowrap;border-top:1px solid #e3e8e5&quot;&gt;&lt;u&gt;&lt;b&gt;CourseID&lt;/b&gt;&lt;/u&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 8px;color:#5b6b73;border-top:1px solid #e3e8e5&quot;&gt;INT&lt;/td&gt;&lt;td style=&quot;padding:2px 8px;color:#0b7a6b;font-weight:bold;border-top:1px solid #e3e8e5&quot;&gt;PK&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 8px;white-space:nowrap;border-top:1px solid #e3e8e5&quot;&gt;Title&lt;/td&gt;&lt;td style=&quot;padding:2px 8px;color:#5b6b73;border-top:1px solid #e3e8e5&quot;&gt;NVARCHAR(100)&lt;/td&gt;&lt;td style=&quot;padding:2px 8px;color:#0b7a6b;font-weight:bold;border-top:1px solid #e3e8e5&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 8px;white-space:nowrap;border-top:1px solid #e3e8e5&quot;&gt;Credits&lt