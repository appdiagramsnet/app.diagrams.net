<mxGeometry x="40" y="953" width="1273" height="41" as="geometry"/></mxCell><mxCell id="1405-25" value="&lt;table style=&quot;border-collapse:collapse;font-size:12px;width:100%&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;Табела&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;Колони (PK, FK →)&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;Забелешка&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Person&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;PersonID (IDENTITY), LastName, FirstName, HireDate, EnrollmentDate, Discriminator&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;И студенти и инструктори. Discriminator = &amp;#x27;Student&amp;#x27; / &amp;#x27;Instructor&amp;#x27;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Department&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;DepartmentID, Name, Budget (money), StartDate (datetime), Administrator&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;4 реда: 1, 2, 4, 7. ID не е IDENTITY&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Course&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;CourseID, Title, Credits, DepartmentID → Department&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;ID не е IDENTITY&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;StudentGrade&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;EnrollmentID (IDENTITY), CourseID → Course, StudentID → Person, Grade&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Врската студент ↔ курс&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;CourseInstructor&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;CourseID → Course, PersonID → Person&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Врската инструктор ↔ курс (M:N)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;OfficeAssignment&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;InstructorID → Person, Location, Timestamp&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;OnlineCourse&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;CourseID → Course, URL&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;OnsiteCourse&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;CourseID → Course, Location, Days, Time&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="989" width="1273" height="195" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="183-29" name="SQL 1–4"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1298" pageHeight="1792" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="183-1" value="SQL 1   [3 поени]" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#142027;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1000" height="32" as="geometry"/></mxCell><mxCell id="183-2" value="&lt;i&gt;Find all courses (title, credits) and Department name for each department and course where we have more than 3 credits.&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="38" width="1000" height="45" as="geometry"/></mxCell><mxCell id="183-3" value="JOIN од Course кон Department по &lt;b&gt;DepartmentID&lt;/b&gt;, со услов &lt;b&gt;Credits &amp;gt; 3&lt;/b&gt; (строго поголемо, значи 4 и повеќе)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="89" width="1000" height="41" as="geometry"/></mxCell><mxCell id="183-4" value="&lt;pre style=&quot;margin:0;font-family:Courier New,monospace;font-size:12px;line-height:15px;text-align:left;white-space:pre&quot;&gt;SELECT c.Title, c.Credits, d.Name AS DepartmentName&#xa;FROM Course AS c&#xa;JOIN Department AS d ON d.DepartmentID = c.DepartmentID&#xa;WHERE c.Credits &amp;gt; 3;&lt;/pre&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;spacingLeft=10;spacingTop=6;fontColor=#142027;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="40" y="134" width="423" height="80" as="geometry"/></mxCell><mxCell id="183-5" value="&lt;b&gt;Резултат&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="630" y="134" width="285" height="41" as="geometry"/></mxCell><mxCell id="183-6" value="&lt;table style=&quot;border-collapse:collapse;font-size:11px;width:100%&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;Title&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;Credits&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;DepartmentName&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Calculus&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;4&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Mathematics&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Chemistry&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;4&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Engineering&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Physics&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;4&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Engineering&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Literature&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;4&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;English&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Trigonometry&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;4&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Mathematics&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;spacing=0;" vertex="1" parent="1"><mxGeometry x="630" y="171" width="285" height="126" as="geometry"/></mxCell><mxCell id="183-7" value="&lt;span style=&#x27;color:#5b6b73&#x27;&gt;Ако ја извршиш после SQL 3, ќе видиш 7 реда (плус DB и DDB од ICT). На испитот редоследот на задачите е 1 → 2 → 3, па screenshot-от покажува 5 реда.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="317" width="1000" height="39" as="geometry"/></mxCell><mxCell id="183-8" value="SQL 2   [3 поени]" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#142027;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="395" width="1000" height="32" as="geometry"/></mxCell><mxCell id="183-9" value="&lt;i&gt;Insert 3 (three) new students in the table Person and 1 (one) new Instructor&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="433" width="1000" height="45" as="geometry"/></mxCell><mxCell id="183-10" value="&lt;ul style=&quot;margin:2px 0 6px 0;padding-left:20px;text-align:left&quot;&gt;&lt;li style=&quot;margin:0 0 2px 0&quot;&gt;&lt;b&gt;Без PersonID.&lt;/b&gt; Колоната е IDENTITY, па SQL Server сам ги дава 35, 36, 37, 38.&lt;/li&gt;&lt;li style=&quot;margin:0 0 2px 0&quot;&gt;Студент: &lt;b&gt;EnrollmentDate&lt;/b&gt; + &lt;b&gt;Discriminator = &#x27;Student&#x27;&lt;/b&gt;, HireDate е NULL.&lt;/li&gt;&lt;li style=&quot;margin:0 0 2px 0&quot;&gt;Инструктор: &lt;b&gt;HireDate&lt;/b&gt; + &lt;b&gt;Discriminator = &#x27;Instructor&#x27;&lt;/b&gt;, EnrollmentDate е NULL.&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="484" width="1000" height="100" as="geometry"/></mxCell><mxCell id="183-11" value="&lt;pre style=&quot;margin:0;font-family:Courier New,monospace;font-size:12px;line-height:15px;text-align:left;white-space:pre&quot;&gt;INSERT INTO Person (LastName, FirstName, HireDate, EnrollmentDate, Discriminator)&#xa;VALUES (&amp;#x27;Petrovski&amp;#x27;, &amp;#x27;Marko&amp;#x27;, NULL, &amp;#x27;20241001&amp;#x27;, &amp;#x27;Student&amp;#x27;),&#xa;       (&amp;#x27;Nikolova&amp;#x27;,  &amp;#x27;Ana&amp;#x27;,   NULL, &amp;#x27;20241001&amp;#x27;, &amp;#x27;Student&amp;#x27;),&#xa;       (&amp;#x27;Trajkovski&amp;#x27;,&amp;#x27;Stefan&amp;#x27;,NULL, &amp;#x27;20241001&amp;#x27;, &amp;#x27;Student&amp;#x27;);&#xa;&#xa;INSERT INTO Person (LastName, FirstName, HireDate, EnrollmentDate, Discriminator)&#xa;VALUES (&amp;#x27;Stojanovski&amp;#x27;, &amp;#x27;Ivan&amp;#x27;, &amp;#x27;20240901&amp;#x27;, NULL, &amp;#x27;Instructor&amp;#x27;);&#xa;&#xa;SELECT * FROM Person WHERE PersonID &amp;gt; 34;&lt;/pre&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;spacingLeft=10;spacingTop=6;fontColor=#142027;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="40" y="589" width="611" height="155" as="geometry"/></mxCell><mxCell id="183-12" value="&lt;b&gt;Резултат&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="681" y="589" width="557" height="41" as="geometry"/></mxCell><mxCell id="183-13" value="&lt;table style=&quot;border-collapse:collapse;font-size:11px;width:100%&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;PersonID&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;LastName&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;FirstName&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;HireDate&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;EnrollmentDate&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;Discriminator&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;35&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Petrovski&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Marko&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;color:#7a8a91;font-style:italic&quot;&gt;NULL&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;2024-10-01&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Student&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;36&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Nikolova&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Ana&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;color:#7a8a91;font-style:italic&quot;&gt;NULL&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;2024-10-01&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Student&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;37&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Trajkovski&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Stefan&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;color:#7a8a91;font-style:italic&quot;&gt;NULL&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;2024-10-01&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Student&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;38&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Stojanovski&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Ivan&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;2024-09-01&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;color:#7a8a91;font-style:italic&quot;&gt;NULL&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Instructor&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;spacing=0;" vertex="1" parent="1"><mxGeometry x="681" y="625" width="557" height="106" as="geometry"/></mxCell><mxCell id="183-14" value="SQL 3   [4 поени]" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#142027;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="792" width="1000" height="32" as="geometry"/></mxCell><mxCell id="183-15" value="&lt;i&gt;Insert DB Course with 4 credits and ID 5011 from ICT department with budget of 500000 and start date 01-October-2024. Insert DDB Course with 6 credits and ID 5022 from ICT department with budget of 700000 and start date 01-February-2025. Show new records from the respective tables in DB.&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="830" width="1000" height="66" as="geometry"/></mxCell><mxCell id="183-16" value="&lt;ul style=&quot;margin:2px 0 6px 0;padding-left:20px;text-align:left&quot;&gt;&lt;li style=&quot;margin:0 0 2px 0&quot;&gt;ICT не постои, па &lt;b&gt;прво Department, па Course&lt;/b&gt;, поради FK.&lt;/li&gt;&lt;li style=&quot;margin:0 0 2px 0&quot;&gt;Двата курса имаат &lt;b&gt;различен&lt;/b&gt; буџет и почетен датум, а тоа се колони на Department. Затоа има два реда за ICT (ID 10 и 11). DepartmentID не е IDENTITY, па го пишуваш сам.&lt;/li&gt;&lt;li style=&quot;margin:0 0 2px 0&quot;&gt;01-October-2024 се пишува &#x27;20241001&#x27;, а 01-February-2025 се пишува &#x27;20250201&#x27;.&lt;/li&gt;&lt;li style=&quot;margin:0 0 2px 0&quot;&gt;„Show new records“ значи SELECT од двете табели. Screenshot со резултатите.&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="902" width="1000" height="150" as="geometry"/></mxCell><mxCell id="183-17" value="&lt;pre style=&quot;margin:0;font-family:Courier New,monospace;font-size:12px;line-height:15px;text-align:left;white-space:pre&quot;&gt;INSERT INTO Department (DepartmentID, Name, Budget, StartDate, Administrator)&#xa;VALUES (10, &amp;#x27;ICT&amp;#x27;, 500000, &amp;#x27;20241001&amp;#x27;, NULL);&#xa;INSERT INTO Course (CourseID, Title, Credits, DepartmentID)&#xa;VALUES (5011, &amp;#x27;DB&amp;#x27;, 4, 10);&#xa;&#xa;INSERT INTO Department (DepartmentID, Name, Budget, StartDate, Administrator)&#xa;VALUES (11, &amp;#x27;ICT&amp;#x27;, 700000, &amp;#x27;20250201&amp;#x27;, NULL);&#xa;INSERT INTO Course (CourseID, Title, Credits, DepartmentID)&#xa;VALUES (5022, &amp;#x27;DDB&amp;#x27;, 6, 11);&#xa;&#xa;SELECT * FROM Department WHERE DepartmentID IN (10, 11);&#xa;SELECT * FROM Course WHERE CourseID IN (5011, 5022);&#xa;SELECT c.CourseID, c.Title, c.Credits, d.DepartmentID, d.Name, d.Budget, d.StartDate&#xa;FROM Course c JOIN Department d ON d.DepartmentID = c.DepartmentID&#xa;WHERE c.CourseID IN (5011, 5022);&lt;/pre&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;spacingLeft=10;spacingTop=6;fontColor=#142027;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="40" y="1056" width="633" height="245" as="geometry"/></mxCell><mxCell id="183-18" value="&lt;b&gt;Резултат&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="703" y="1056" width="403" height="41" as="geometry"/></mxCell><mxCell id="183-19" value="&lt;table style=&quot;border-collapse:collapse;font-size:11px;width:100%&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;DepartmentID&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;Name&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;Budget&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;StartDate&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;Administrator&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;10&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;ICT&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;500000&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;2024-10-01&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;color:#7a8a91;font-style:italic&quot;&gt;NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;11&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;ICT&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;700000&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;2025-02-01&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;color:#7a8a91;font-style:italic&quot;&gt;NULL&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;spacing=0;" vertex="1" parent="1"><mxGeometry x="703" y="1092" width="403" height="66" as="geometry"/></mxCell><mxCell id="183-20" value="&lt;table style=&quot;border-collapse:collapse;font-size:11px;width:100%&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;CourseID&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;Title&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;Credits&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;DepartmentID&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;5011&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;DB&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;4&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;10&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;5022&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;DDB&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;6&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;11&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;spacing=0;" vertex="1" parent="1"><mxGeometry x="703" y="1170" width="296" height="66" as="geometry"/></mxCell><mxCell id="183-21" value="&lt;table style=&quot;border-collapse:collapse;font-size:11px;width:100%&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;CourseID&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;Title&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;Credits&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;DepartmentID&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;Name&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;Budget&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;StartDate&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;5011&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;DB&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;4&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;10&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;ICT&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;500000&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;2024-10-01&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;5022&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;DDB&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;6&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;11&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;ICT&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;700000&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;2025-02-01&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;spacing=0;" vertex="1" parent="1"><mxGeometry x="703" y="1248" width="487" height="66" as="geometry"/></mxCell><mxCell id="183-22" value="SQL 4   [1 поен]" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#142027;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1374" width="1000" height="32" as="geometry"/></mxCell><mxCell id="183-23" value="&lt;i&gt;Insert new CourseInstructor for DD and DDB.&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="1412" width="1000" height="45" as="geometry"/></mxCell><mxCell id="183-24" value="„DD“ е печатна грешка за &lt;b&gt;DB&lt;/b&gt; (5011). CourseInstructor има само CourseID и PersonID. Земи го новиот инструктор од SQL 2, без да го погодуваш ID-то:" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="1463" width="1000" height="41" as="geometry"/></mxCell><mxCell id="183-25" value="&lt;pre style=&quot;margin:0;font-family:Courier New,monospace;font-size:12px;line-height:15px;text-align:left;white-space:pre&quot;&gt;INSERT INTO CourseInstructor (CourseID, PersonID)&#xa;SELECT 5011, PersonID FROM Person&#xa;WHERE FirstName = &amp;#x27;Ivan&amp;#x27; AND LastName = &amp;#x27;Stojanovski&amp;#x27; AND Discriminator = &amp;#x27;Instructor&amp;#x27;;&#xa;&#xa;INSERT INTO CourseInstructor (CourseID, PersonID)&#xa;SELECT 5022, PersonID FROM Person&#xa;WHERE FirstName = &amp;#x27;Ivan&amp;#x27; AND LastName = &amp;#x27;Stojanovski&amp;#x27; AND Discriminator = &amp;#x27;Instructor&amp;#x27;;&#xa;&#xa;SELECT * FROM CourseInstructor WHERE CourseID IN (5011, 5022);&lt;/pre&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;spacingLeft=10;spacingTop=6;fontColor=#142027;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="40" y="1508" width="655" height="155" as="geometry"/></mxCell><mxCell id="183-26" value="&lt;b&gt;Резултат&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="725" y="1508" width="160" height="41" as="geometry"/></mxCell><mxCell id="183-27" value="&lt;table style=&quot;border-collapse:collapse;font-size:11px;width:100%&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;CourseID&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;PersonID&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;5011&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;38&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;5022&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;38&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;spacing=0;" vertex="1" parent="1"><mxGeometry x="725" y="1545" width="151" height="66" as="geometry"/></mxCell><mxCell id="183-28" value="&lt;span style=&#x27;color:#5b6b73&#x27;&gt;Полесна варијанта: прво SELECT * FROM Person WHERE PersonID &amp;gt; 34; види го ID-то на инструкторот (кај нас 38), па INSERT INTO CourseInstructor (CourseID, PersonID) VALUES (5011, 38), (5022, 38);&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="1671" width="1000" height="61" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="8265-27" name="Query 1–3"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1260" pageHeight="2464" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="8265-1" value="Query 1   [5 поени]" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#142027;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1000" height="32" as="geometry"/></mxCell><mxCell id="8265-2" value="&lt;i&gt;Find info for each student (First and Last Name, enrolment date), course name credits for the course and department name.&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="38" width="1000" height="45" as="geometry"/></mxCell><mxCell id="8265-3" value="Четири табели: &lt;b&gt;Person → StudentGrade → Course → Department&lt;/b&gt;. StudentGrade ги поврзува студентот и курсот." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="89" width="1000" height="41" as="geometry"/></mxCell><mxCell id="8265-4" value="&lt;pre style=&quot;margin:0;font-family:Courier New,monospace;font-size:12px;line-height:15px;text-align:left;white-space:pre&quot;&gt;SELECT p.FirstName, p.LastName, p.EnrollmentDate,&#xa;       c.Title AS CourseName, c.Credits, d.Name AS DepartmentName&#xa;FROM Person AS p&#xa;JOIN StudentGrade AS sg ON sg.StudentID = p.PersonID&#xa;JOIN Course AS c        ON c.CourseID = sg.CourseID&#xa;JOIN Department AS d    ON d.DepartmentID = c.DepartmentID&#xa;ORDER BY p.LastName, p.FirstName;&lt;/pre&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;spacingLeft=10;spacingTop=6;fontColor=#142027;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="40" y="134" width="495" height="125" as="geometry"/></mxCell><mxCell id="8265-5" value="&lt;b&gt;Резултат&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="630" y="134" width="571" height="41" as="geometry"/></mxCell><mxCell id="8265-6" value="&lt;table style=&quot;border-collapse:collapse;font-size:11px;width:100%&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;FirstName&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;LastName&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;EnrollmentDate&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;CourseName&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;Credits&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;DepartmentName&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Carson&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Alexander&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;2005-09-01&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Microeconomics&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;3&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Economics&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Carson&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Alexander&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;2005-09-01&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Macroeconomics&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;3&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Economics&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Carson&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Alexander&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;2005-09-01&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Quantitative&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;2&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Economics&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Meredith&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Alonso&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;2002-09-01&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Macroeconomics&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;3&lt;/td&gt;&lt;td style=