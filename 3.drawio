ot;&gt;Engineering&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Robyn&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Suarez&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;2004-09-01&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Quantitative&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;2&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Economics&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Wayne&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Tang&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;2005-09-01&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Macroeconomics&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;3&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Economics&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Alexandra&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Walker&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;2000-09-01&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Macroeconomics&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;3&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Economics&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Alexandra&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Walker&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;2000-09-01&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Microeconomics&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;3&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Economics&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Anthony&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;White&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;2001-09-01&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Calculus&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;4&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Mathematics&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Anthony&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;White&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;2001-09-01&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Chemistry&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;4&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Engineering&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;spacing=0;" vertex="1" parent="1"><mxGeometry x="630" y="171" width="571" height="826" as="geometry"/></mxCell><mxCell id="8265-7" value="Двајца &lt;b&gt;инструктори&lt;/b&gt; (Kapoor и Serrano, ID 25 и 27) имаат оценки на Physics, па без филтер излегуваат 40 реда. Со &lt;b&gt;WHERE p.Discriminator = &#x27;Student&#x27;&lt;/b&gt; излегуваат 38. Двете решенија се прифатливи, а филтерот покажува дека ја разбираш табелата Person." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#dcefe9;strokeColor=#0b7a6b;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="1017" width="560" height="108" as="geometry"/></mxCell><mxCell id="8265-8" value="Query 2   [6 поени]" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#142027;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1165" width="1000" height="32" as="geometry"/></mxCell><mxCell id="8265-9" value="&lt;i&gt;Find the number of students per course. In the output we need to see number of students and course name.&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="1203" width="1000" height="45" as="geometry"/></mxCell><mxCell id="8265-10" value="GROUP BY по курс и COUNT на студенти. Колоната &lt;b&gt;c.Title&lt;/b&gt; е во SELECT, па мора да биде и во GROUP BY." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="1254" width="1000" height="41" as="geometry"/></mxCell><mxCell id="8265-11" value="&lt;pre style=&quot;margin:0;font-family:Courier New,monospace;font-size:12px;line-height:15px;text-align:left;white-space:pre&quot;&gt;SELECT c.Title AS CourseName, COUNT(DISTINCT sg.StudentID) AS NumberOfStudents&#xa;FROM Course AS c&#xa;JOIN StudentGrade AS sg ON sg.CourseID = c.CourseID&#xa;GROUP BY c.Title&#xa;ORDER BY NumberOfStudents DESC;&lt;/pre&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;spacingLeft=10;spacingTop=6;fontColor=#142027;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="40" y="1298" width="590" height="95" as="geometry"/></mxCell><mxCell id="8265-12" value="&lt;b&gt;Резултат&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="660" y="1298" width="247" height="41" as="geometry"/></mxCell><mxCell id="8265-13" value="&lt;table style=&quot;border-collapse:collapse;font-size:11px;width:100%&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;CourseName&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;NumberOfStudents&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Microeconomics&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;8&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Physics&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;6&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Macroeconomics&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;6&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Quantitative&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;5&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Composition&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;5&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Literature&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Chemistry&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Calculus&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Poetry&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;2&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;spacing=0;" vertex="1" parent="1"><mxGeometry x="660" y="1335" width="247" height="206" as="geometry"/></mxCell><mxCell id="8265-14" value="&lt;b&gt;Варијанта:&lt;/b&gt; сите курсеви, и оние без студенти (LEFT JOIN)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="1561" width="1000" height="43" as="geometry"/></mxCell><mxCell id="8265-15" value="&lt;pre style=&quot;margin:0;font-family:Courier New,monospace;font-size:12px;line-height:15px;text-align:left;white-space:pre&quot;&gt;SELECT c.Title AS CourseName, COUNT(sg.StudentID) AS NumberOfStudents&#xa;FROM Course AS c&#xa;LEFT JOIN StudentGrade AS sg ON sg.CourseID = c.CourseID&#xa;GROUP BY c.Title&#xa;ORDER BY NumberOfStudents DESC;&lt;/pre&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;spacingLeft=10;spacingTop=6;fontColor=#142027;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="40" y="1604" width="524" height="95" as="geometry"/></mxCell><mxCell id="8265-16" value="&lt;table style=&quot;border-collapse:collapse;font-size:11px;width:100%&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;CourseName&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;NumberOfStudents&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Microeconomics&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;8&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Physics&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;6&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Macroeconomics&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;6&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Composition&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;5&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Quantitative&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;5&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Chemistry&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Literature&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Poetry&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Calculus&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;DB&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;DDB&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Trigonometry&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;0&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;spacing=0;" vertex="1" parent="1"><mxGeometry x="630" y="1604" width="247" height="266" as="geometry"/></mxCell><mxCell id="8265-17" value="Со LEFT JOIN се користи &lt;b&gt;COUNT(sg.StudentID)&lt;/b&gt;, а не COUNT(*). COUNT(*) би дал 1 за курс без студенти." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="1876" width="1000" height="39" as="geometry"/></mxCell><mxCell id="8265-18" value="Query 3   [6 поени]" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#142027;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1955" width="1000" height="32" as="geometry"/></mxCell><mxCell id="8265-19" value="&lt;i&gt;Find the number of students per department. In the output we need to see number of students and department name.&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="1993" width="1000" height="45" as="geometry"/></mxCell><mxCell id="8265-20" value="Department → Course → StudentGrade. Еден студент може да слуша &lt;b&gt;повеќе курсеви во ист департман&lt;/b&gt;, па затоа &lt;b&gt;COUNT(DISTINCT sg.StudentID)&lt;/b&gt;." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="2044" width="1000" height="41" as="geometry"/></mxCell><mxCell id="8265-21" value="&lt;pre style=&quot;margin:0;font-family:Courier New,monospace;font-size:12px;line-height:15px;text-align:left;white-space:pre&quot;&gt;SELECT d.Name AS DepartmentName, COUNT(DISTINCT sg.StudentID) AS NumberOfStudents&#xa;FROM Department AS d&#xa;JOIN Course AS c        ON c.DepartmentID = d.DepartmentID&#xa;JOIN StudentGrade AS sg ON sg.CourseID = c.CourseID&#xa;GROUP BY d.Name&#xa;ORDER BY NumberOfStudents DESC;&lt;/pre&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;spacingLeft=10;spacingTop=6;fontColor=#142027;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="40" y="2089" width="611" height="110" as="geometry"/></mxCell><mxCell id="8265-22" value="&lt;b&gt;Резултат&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="681" y="2089" width="247" height="41" as="geometry"/></mxCell><mxCell id="8265-23" value="&lt;table style=&quot;border-collapse:collapse;font-size:11px;width:100%&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;DepartmentName&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;NumberOfStudents&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Economics&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;14&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Engineering&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;7&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;English&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;5&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Mathematics&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;2&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;spacing=0;" vertex="1" parent="1"><mxGeometry x="681" y="2125" width="247" height="106" as="geometry"/></mxCell><mxCell id="8265-24" value="&lt;b&gt;Честа грешка:&lt;/b&gt; без DISTINCT се бројат запишувања, не студенти" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="2251" width="1000" height="43" as="geometry"/></mxCell><mxCell id="8265-25" value="&lt;pre style=&quot;margin:0;font-family:Courier New,monospace;font-size:12px;line-height:15px;text-align:left;white-space:pre&quot;&gt;SELECT d.Name AS DepartmentName, COUNT(sg.StudentID) AS Enrollments_not_students&#xa;FROM Department AS d&#xa;JOIN Course AS c        ON c.DepartmentID = d.DepartmentID&#xa;JOIN StudentGrade AS sg ON sg.CourseID = c.CourseID&#xa;GROUP BY d.Name&#xa;ORDER BY 2 DESC;&lt;/pre&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;spacingLeft=10;spacingTop=6;fontColor=#142027;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="40" y="2294" width="604" height="110" as="geometry"/></mxCell><mxCell id="8265-26" value="&lt;table style=&quot;border-collapse:collapse;font-size:11px;width:100%&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;DepartmentName&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;Enrollments_not_students&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Economics&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;19&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;English&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;10&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Engineering&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;9&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Mathematics&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;2&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;spacing=0;" vertex="1" parent="1"><mxGeometry x="674" y="2294" width="301" height="106" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="8812-20" name="Backup, ZIP, upload + шаблони"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="1187" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="8812-1" value="Backup, ZIP и upload   [2 поени]" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#142027;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1000" height="36" as="geometry"/></mxCell><mxCell id="8812-2" value="&lt;i&gt;Create backup from this DB (save backup file on new folder backup in C:\ DBPartTime062026). Note: if missing rows from task 3 then 0.5 Points if backup is ok. Create zip file from this folder (word document, and backup file, screens and other related info) and upload this file on moodle.&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1100" height="66" as="geometry"/></mxCell><mxCell id="8812-3" value="&lt;div style=&quot;font-weight:bold;font-size:14px;margin:6px 0 2px 0;text-align:left&quot;&gt;1. Backup (после сите INSERT задачи)&lt;/div&gt;&lt;ol style=&quot;margin:2px 0 6px 0;padding-left:20px;text-align:left&quot;&gt;&#xa;&lt;li style=&quot;margin:0 0 2px 0&quot;&gt;Креирај ја папката C:\DBPartTime062026\backup.&lt;/li&gt;&#xa;&lt;li style=&quot;margin:0 0 2px 0&quot;&gt;GUI: десен клик на &lt;b&gt;School&lt;/b&gt; → &lt;i&gt;Tasks → Back Up…&lt;/i&gt; → Backup type: &lt;b&gt;Full&lt;/b&gt; → Destination: &lt;i&gt;Remove&lt;/i&gt; на стариот, &lt;i&gt;Add…&lt;/i&gt; → C:\DBPartTime062026\backup\School.bak → OK.&lt;/li&gt;&#xa;&lt;li style=&quot;margin:0 0 2px 0&quot;&gt;Или со T‑SQL (screenshot на пораката &lt;i&gt;BACKUP DATABASE successfully processed…&lt;/i&gt;):&lt;/li&gt;&lt;/ol&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="116" width="540" height="167" as="geometry"/></mxCell><mxCell id="8812-4" value="&lt;pre style=&quot;margin:0;font-family:Courier New,monospace;font-size:12px;line-height:15px;text-align:left;white-space:pre&quot;&gt;BACKUP DATABASE School&#xa;TO DISK = N&amp;#x27;C:\DBPartTime062026\backup\School.bak&amp;#x27;&#xa;WITH INIT, NAME = N&amp;#x27;School full backup&amp;#x27;;&lt;/pre&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;spacingLeft=10;spacingTop=6;fontColor=#142027;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="40" y="283" width="386" height="65" as="geometry"/></mxCell><mxCell id="8812-5" value="&lt;b&gt;Operating system error 5 (Access is denied)&lt;/b&gt; значи дека SQL Server сервисот нема право на папката. Решение: зачувај го бекапот во стандардната папка (C:\Program Files\Microsoft SQL Server\MSSQL16.SQLEXPRESS\MSSQL\Backup\) и копирај ја датотеката во својата папка. Друг начин: Properties на папката → Security → Edit → Add NT Service\MSSQL$SQLEXPRESS → Full control." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fbf1d9;strokeColor=#7a5200;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="358" width="540" height="129" as="geometry"/></mxCell><mxCell id="8812-6" value="&lt;div style=&quot;font-weight:bold;font-size:14px;margin:6px 0 2px 0;text-align:left&quot;&gt;2. ZIP&lt;/div&gt;&lt;p style=&quot;margin:2px 0 6px 0;text-align:left&quot;&gt;Во папката треба да има: Word документ (Ime_Prezime_ID.docx), backup\School.bak, screenshot-и и ER сликата.&lt;/p&gt;&#xa;&lt;p style=&quot;margin:2px 0 6px 0;text-align:left&quot;&gt;Во File Explorer: десен клик на C:\DBPartTime062026 → &lt;i&gt;Compress to → ZIP File&lt;/i&gt; (Windows 11) или &lt;i&gt;Send to → Compressed (zipped) folder&lt;/i&gt;.&lt;/p&gt;&#xa;&lt;div style=&quot;font-weight:bold;font-size:14px;margin:6px 0 2px 0;text-align:left&quot;&gt;3. Upload&lt;/div&gt;&lt;ol style=&quot;margin:2px 0 6px 0;padding-left:20px;text-align:left&quot;&gt;&lt;li style=&quot;margin:0 0 2px 0&quot;&gt;Moodle задача → &lt;b&gt;Add submission&lt;/b&gt; → повлечи го ZIP-от → &lt;b&gt;Save changes&lt;/b&gt;.&lt;/li&gt;&lt;li style=&quot;margin:0 0 2px 0&quot;&gt;Ако има копче &lt;b&gt;Submit assignment&lt;/b&gt;, кликни и потврди.&lt;/li&gt;&lt;li style=&quot;margin:0 0 2px 0&quot;&gt;Провери дека пишува &lt;i&gt;Submitted for grading&lt;/i&gt;, пред 19:30.&lt;/li&gt;&lt;/ol&gt;&#xa;&lt;div style=&quot;font-weight:bold;font-size:14px;margin:6px 0 2px 0;text-align:left&quot;&gt;Word документот&lt;/div&gt;&lt;ul style=&quot;margin:2px 0 6px 0;padding-left:20px;text-align:left&quot;&gt;&lt;li style=&quot;margin:0 0 2px 0&quot;&gt;Име, презиме и индекс горе.&lt;/li&gt;&lt;li style=&quot;margin:0 0 2px 0&quot;&gt;За секоја задача табела со два реда: &lt;b&gt;SQL&lt;/b&gt; (залепен код) и &lt;b&gt;Screen from SQL execution&lt;/b&gt; (слика).&lt;/li&gt;&lt;li style=&quot;margin:0 0 2px 0&quot;&gt;ER дијаграм со листа на ентитети, врски, кардиналности и 3 инстанци.&lt;/li&gt;&lt;li style=&quot;margin:0 0 2px 0&quot;&gt;Табеларен модел (табели со тип, големина, задолжително) и план за внесување.&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="620" y="116" width="520" height="480" as="geometry"/></mxCell><mxCell id="8812-7" value="Шаблони за напамет" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#142027;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="636" width="800" height="32" as="geometry"/></mxCell><mxCell id="8812-8" value="&lt;b&gt;JOIN преку повеќе табели&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="674" width="560" height="43" as="geometry"/></mxCell><mxCell id="8812-9" value="&lt;pre style=&quot;margin:0;font-family:Courier New,monospace;font-size:12px;line-height:15px;text-align:left;white-space:pre&quot;&gt;SELECT a.Col1, b.Col2&#xa;FROM TableA AS a&#xa;JOIN TableB AS b ON b.AID = a.AID&#xa;JOIN TableC AS c ON c.BID = b.BID&#xa;WHERE a.Col3 &amp;gt; 3&#xa;ORDER BY a.Col1;&lt;/pre&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;spacingLeft=10;spacingTop=6;fontColor=#142027;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="40" y="717" width="560" height="110" as="geometry"/></mxCell><mxCell id="8812-10" value="&lt;b&gt;Број по група&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="640" y="674" width="620" height="43" as="geometry"/></mxCell><mxCell id="8812-11" value="&lt;pre style=&quot;margin:0;font-family:Courier New,monospace;font-size:12px;line-height:15px;text-align:left;white-space:pre&quot;&gt;SELECT g.Name, COUNT(DISTINCT x.ID) AS N&#xa;FROM Groups AS g&#xa;JOIN Items AS x ON x.GroupID = g.GroupID&#xa;GROUP BY g.Name            -- сè што е во SELECT, а не е агрегат&#xa;HAVING COUNT(DISTINCT x.ID) &amp;gt;= 5   -- услов врз групата&#xa;ORDER BY N DESC;&lt;/pre&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;spacingLeft=10;spacingTop=6;fontColor=#142027;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="640" y="717" width="620" height="110" as="geometry"/></mxCell><mxCell id="8812-12" value="&lt;b&gt;INSERT (без IDENTITY колона)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="847" width="560" height="43" as="geometry"/></mxCell><mxCell id="8812-13" value="&lt;pre style=&quot;margin:0;font-family:Courier New,monospace;font-size:12px;line-height:15px;text-align:left;white-space:pre&quot;&gt;INSERT INTO Person (LastName, FirstName, HireDate, EnrollmentDate, Discriminator)&#xa;VALUES (&amp;#x27;Petrovski&amp;#x27;, &amp;#x27;Marko&amp;#x27;, NULL, &amp;#x27;20241001&amp;#x27;, &amp;#x27;Student&amp;#x27;),&#xa;       (&amp;#x27;Nikolova&amp;#x27;,  &amp;#x27;Ana&amp;#x27;,   NULL, &amp;#x27;20241001&amp;#x27;, &amp;#x27;Student&amp;#x27;);&lt;/pre&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;spacingLeft=10;spacingTop=6;fontColor=#142027;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="40" y="890" width="611" height="65" as="geometry"/></mxCell><mxCell id="8812-14" value="&lt;b&gt;Без пар: LEFT JOIN + IS NULL&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="640" y="847" width="620" height="43" as="geometry"/></mxCell><mxCell id="8812-15" value="&lt;pre style=&quot;margin:0;font-family:Courier New,monospace;font-size:12px;line-height:15px;text-align:left;white-space:pre&quot;&gt;SELECT c.CourseID, c.Title&#xa;FROM Course AS c&#xa;LEFT JOIN StudentGrade AS sg ON sg.CourseID = c.CourseID&#xa;WHERE sg.EnrollmentID IS NULL;&lt;/pre&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;spacingLeft=10;spacingTop=6;fontColor=#142027;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="640" y="890" width="620" height="80" as="geometry"/></mxCell><mxCell id="8812-16" value="&lt;b&gt;UPDATE / DELETE секогаш со WHERE&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="990" width="560" height="43" as="geometry"/></mxCell><mxCell id="8812-17" value="&lt;pre style=&quot;margin:0;font-family:Courier New,monospace;font-size:12px;line-height:15px;text-align:left;white-space:pre&quot;&gt;UPDATE Department SET Budget = Budget * 1.1 WHERE Name = &amp;#x27;Mathematics&amp;#x27;;&#xa;DELETE FROM CourseInstructor WHERE CourseID = 5022 AND PersonID = 38;&lt;/pre&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;spacingLeft=10;spacingTop=6;fontColor=#142027;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="40" y="1032" width="560" height="50" as="geometry"/></mxCell><mxCell id="8812-18" value="&lt;b&gt;Редослед на клаузулите&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="640" y="990" width="620" height="43" as="geometry"/></mxCell><mxCell id="8812-19" value="&lt;pre style=&quot;margin:0;font-family:Courier New,monospace;font-size:12px;line-height:15px;text-align:left;white-space:pre&quot;&gt;SELECT … FROM … JOIN … ON …&#xa;WHERE …      -- пред групирање, без агрегати&#xa;GROUP BY …&#xa;HAVING …     -- после групирање, со агрегати&#xa;ORDER BY …   -- тука смее алијас&lt;/pre&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;spacingLeft=10;spacingTop=6;fontColor=#142027;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="640" y="1032" width="620" height="95" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>