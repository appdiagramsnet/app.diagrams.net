rap;border-top:1px solid #e3e8e5&quot;&gt;Quantity&lt;/td&gt;&lt;td style=&quot;padding:2px 8px;color:#5b6b73;border-top:1px solid #e3e8e5&quot;&gt;INT&lt;/td&gt;&lt;td style=&quot;padding:2px 8px;color:#0b7a6b;font-weight:bold;border-top:1px solid #e3e8e5&quot;&gt;CHECK&gt;0&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;overflow=fill;fillColor=#ffffff;strokeColor=#142027;verticalAlign=top;align=left;spacing=0;" vertex="1" parent="1"><mxGeometry x="706" y="2273" width="200" height="85" as="geometry"/></mxCell><mxCell id="3340-80" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot;&gt;&lt;tr&gt;&lt;th colspan=&quot;3&quot; style=&quot;background:#0b7a6b;color:#fff;padding:4px;font-size:12px&quot;&gt;PRODUCT&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 8px;white-space:nowrap;border-top:1px solid #e3e8e5&quot;&gt;&lt;u&gt;&lt;b&gt;ProductID&lt;/b&gt;&lt;/u&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 8px;color:#5b6b73;border-top:1px solid #e3e8e5&quot;&gt;INT&lt;/td&gt;&lt;td style=&quot;padding:2px 8px;color:#0b7a6b;font-weight:bold;border-top:1px solid #e3e8e5&quot;&gt;PK&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 8px;white-space:nowrap;border-top:1px solid #e3e8e5&quot;&gt;Name&lt;/td&gt;&lt;td style=&quot;padding:2px 8px;color:#5b6b73;border-top:1px solid #e3e8e5&quot;&gt;NVARCHAR(100)&lt;/td&gt;&lt;td style=&quot;padding:2px 8px;color:#0b7a6b;font-weight:bold;border-top:1px solid #e3e8e5&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 8px;white-space:nowrap;border-top:1px solid #e3e8e5&quot;&gt;Unit&lt;/td&gt;&lt;td style=&quot;padding:2px 8px;color:#5b6b73;border-top:1px solid #e3e8e5&quot;&gt;NVARCHAR(10)&lt;/td&gt;&lt;td style=&quot;padding:2px 8px;color:#0b7a6b;font-weight:bold;border-top:1px solid #e3e8e5&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;overflow=fill;fillColor=#ffffff;strokeColor=#142027;verticalAlign=top;align=left;spacing=0;" vertex="1" parent="1"><mxGeometry x="367" y="2273" width="228" height="85" as="geometry"/></mxCell><mxCell id="3340-81" value="TypeID" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#0b7a6b;fontSize=10;fontColor=#0b7a6b;" edge="1" parent="1" source="3340-76" target="3340-75"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="3340-82" value="StoreID" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#0b7a6b;fontSize=10;fontColor=#0b7a6b;" edge="1" parent="1" source="3340-77" target="3340-76"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="3340-83" value="WarehouseID" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#0b7a6b;fontSize=10;fontColor=#0b7a6b;" edge="1" parent="1" source="3340-77" target="3340-78"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="3340-84" value="SupplyID" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#0b7a6b;fontSize=10;fontColor=#0b7a6b;" edge="1" parent="1" source="3340-79" target="3340-77"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="3340-85" value="ProductID" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#0b7a6b;fontSize=10;fontColor=#0b7a6b;" edge="1" parent="1" source="3340-79" target="3340-80"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="3340-86" value="&lt;span style=&quot;color:#5b6b73&quot;&gt;All columns are NOT NULL. Arrow = FK → PK.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="35" y="2378" width="500" height="39" as="geometry"/></mxCell><mxCell id="3340-87" value="DDL + INSERT (T-SQL, tested in SQL Server)" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#142027;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="35" y="2408" width="700" height="30" as="geometry"/></mxCell><mxCell id="3340-88" value="&lt;pre style=&quot;margin:0;font-family:Courier New,monospace;font-size:12px;line-height:15px;text-align:left;white-space:pre&quot;&gt;CREATE TABLE STORE_TYPE (&#xa;  TypeID   INT          NOT NULL PRIMARY KEY,&#xa;  TypeName NVARCHAR(30) NOT NULL UNIQUE&#xa;);&#xa;CREATE TABLE STORE (&#xa;  StoreID INT           NOT NULL PRIMARY KEY,&#xa;  Address NVARCHAR(150) NOT NULL,&#xa;  Manager NVARCHAR(100) NOT NULL,&#xa;  SizeM2  DECIMAL(8,2)  NOT NULL CHECK (SizeM2 &amp;gt; 0),&#xa;  TypeID  INT           NOT NULL REFERENCES STORE_TYPE(TypeID)&#xa;);&#xa;CREATE TABLE WAREHOUSE (&#xa;  WarehouseID INT           NOT NULL PRIMARY KEY,&#xa;  Name        NVARCHAR(100) NOT NULL UNIQUE,&#xa;  Phone       NVARCHAR(20)  NOT NULL&#xa;);&#xa;CREATE TABLE PRODUCT (&#xa;  ProductID INT           NOT NULL PRIMARY KEY,&#xa;  Name      NVARCHAR(100) NOT NULL,&#xa;  Unit      NVARCHAR(10)  NOT NULL&#xa;);&#xa;CREATE TABLE SUPPLY (&#xa;  SupplyID    INT  NOT NULL PRIMARY KEY,&#xa;  SupplyDate  DATE NOT NULL,&#xa;  WarehouseID INT  NOT NULL REFERENCES WAREHOUSE(WarehouseID),&#xa;  StoreID     INT  NOT NULL REFERENCES STORE(StoreID)&#xa;);&#xa;CREATE TABLE SUPPLY_ITEM (&#xa;  SupplyID  INT NOT NULL REFERENCES SUPPLY(SupplyID),&#xa;  ProductID INT NOT NULL REFERENCES PRODUCT(ProductID),&#xa;  Quantity  INT NOT NULL CHECK (Quantity &amp;gt; 0),&#xa;  PRIMARY KEY (SupplyID, ProductID)&#xa;);&#xa;&#xa;INSERT INTO STORE_TYPE (TypeID, TypeName) VALUES&#xa;  (1, &amp;#x27;Shop-store&amp;#x27;), (2, &amp;#x27;Supermarket&amp;#x27;), (3, &amp;#x27;Discount&amp;#x27;);&#xa;INSERT INTO STORE (StoreID, Address, Manager, SizeM2, TypeID) VALUES&#xa;  (101, &amp;#x27;Partizanska 12, Skopje&amp;#x27;,  &amp;#x27;Ana Petrova&amp;#x27;,     120, 1),&#xa;  (102, &amp;#x27;Bul. Ilinden 45, Skopje&amp;#x27;, &amp;#x27;Marko Iliev&amp;#x27;,     850, 2),&#xa;  (103, &amp;#x27;Goce Delchev 8, Bitola&amp;#x27;,  &amp;#x27;Elena Stojanova&amp;#x27;, 400, 3);&#xa;INSERT INTO WAREHOUSE (WarehouseID, Name, Phone) VALUES&#xa;  (1, &amp;#x27;Central Warehouse Skopje&amp;#x27;, &amp;#x27;02 3111 222&amp;#x27;),&#xa;  (2, &amp;#x27;Warehouse Bitola&amp;#x27;,         &amp;#x27;047 222 333&amp;#x27;),&#xa;  (3, &amp;#x27;Warehouse Shtip&amp;#x27;,          &amp;#x27;032 444 555&amp;#x27;);&#xa;INSERT INTO PRODUCT (ProductID, Name, Unit) VALUES&#xa;  (1, &amp;#x27;Milk 1L&amp;#x27;, &amp;#x27;pcs&amp;#x27;), (2, &amp;#x27;Bread 500g&amp;#x27;, &amp;#x27;pcs&amp;#x27;), (3, &amp;#x27;Apples&amp;#x27;, &amp;#x27;kg&amp;#x27;);&#xa;INSERT INTO SUPPLY (SupplyID, SupplyDate, WarehouseID, StoreID) VALUES&#xa;  (1001, &amp;#x27;2026-11-01&amp;#x27;, 1, 101),&#xa;  (1002, &amp;#x27;2026-11-02&amp;#x27;, 2, 103),&#xa;  (1003, &amp;#x27;2026-11-02&amp;#x27;, 1, 102);&#xa;INSERT INTO SUPPLY_ITEM (SupplyID, ProductID, Quantity) VALUES&#xa;  (1001, 1, 50), (1001, 2, 30), (1002, 3, 120), (1003, 1, 200);&#xa;&#xa;SELECT s.SupplyID, s.SupplyDate, w.Name AS Warehouse, st.Address AS Store, t.TypeName, p.Name AS Product, si.Quantity&#xa;FROM SUPPLY AS s&#xa;JOIN WAREHOUSE AS w    ON w.WarehouseID = s.WarehouseID&#xa;JOIN STORE AS st       ON st.StoreID = s.StoreID&#xa;JOIN STORE_TYPE AS t   ON t.TypeID = st.TypeID&#xa;JOIN SUPPLY_ITEM AS si ON si.SupplyID = s.SupplyID&#xa;JOIN PRODUCT AS p      ON p.ProductID = si.ProductID&#xa;ORDER BY s.SupplyID;&lt;/pre&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;spacingLeft=10;spacingTop=6;fontColor=#142027;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="35" y="2444" width="872" height="935" as="geometry"/></mxCell><mxCell id="3340-89" value="&lt;b&gt;Result of the SELECT&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="35" y="3393" width="773" height="41" as="geometry"/></mxCell><mxCell id="3340-90" value="&lt;table style=&quot;border-collapse:collapse;font-size:11px;width:100%&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;SupplyID&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;SupplyDate&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;Warehouse&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;Store&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;TypeName&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;Product&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;Quantity&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;1001&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;2026-11-01&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Central Warehouse Skopje&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Partizanska 12, Skopje&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Shop-store&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Milk 1L&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;50&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;1001&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;2026-11-01&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Central Warehouse Skopje&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Partizanska 12, Skopje&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Shop-store&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Bread 500g&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;30&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;1002&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;2026-11-02&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Warehouse Bitola&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Goce Delchev 8, Bitola&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Discount&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Apples&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;120&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;1003&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;2026-11-02&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Central Warehouse Skopje&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Bul. Ilinden 45, Skopje&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Supermarket&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Milk 1L&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;200&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;spacing=0;" vertex="1" parent="1"><mxGeometry x="35" y="3430" width="773" height="106" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>