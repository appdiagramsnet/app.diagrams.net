<mxfile host="app.diagrams.net"><diagram id="3340-91" name="1 · ER diagram - store chain"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1326" pageHeight="3595" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="3340-1" value="1 · ER diagram: store chain   [10 points · in WORD]" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#142027;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="35" y="0" width="1000" height="36" as="geometry"/></mxCell><mxCell id="3340-2" value="&lt;i&gt;A company with a store chain wants to have an application for better products supply activities recording. … It has several stores, and each store is of some type: shop-store, supermarket or discount (in the future, there can be new store types). For every store, besides its type, there are data such as: location (address), manager, and size (m2). On the other hand, the company has its own warehouses. Every warehouse has a specific name and phone. Every warehouse can deliver products in every store, and every store can ask for products from every warehouse. The supply activity has two important data: the date of supply and the list of products. According to the given text, define ENTITIES, RELATIONS, and Attributes, define relational cardinalities and constraints, create ER diagram and describe the meaning of relational cardinalities. Write down 3 instances/examples for each ENTITY.&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="35" y="42" width="940" height="171" as="geometry"/></mxCell><mxCell id="3340-3" value="WAREHOUSE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#142027;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="35" y="370" width="150" height="46" as="geometry"/></mxCell><mxCell id="3340-4" value="SUPPLY" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#142027;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="365" y="370" width="150" height="46" as="geometry"/></mxCell><mxCell id="3340-5" value="STORE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#142027;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="695" y="370" width="150" height="46" as="geometry"/></mxCell><mxCell id="3340-6" value="PRODUCT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#142027;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="365" y="630" width="150" height="46" as="geometry"/></mxCell><mxCell id="3340-7" value="STORE_TYPE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#142027;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="695" y="630" width="150" height="46" as="geometry"/></mxCell><mxCell id="3340-8" value="delivers" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dcefe9;strokeColor=#0b7a6b;fontSize=13;" vertex="1" parent="1"><mxGeometry x="223" y="363" width="104" height="60" as="geometry"/></mxCell><mxCell id="3340-9" value="receives" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dcefe9;strokeColor=#0b7a6b;fontSize=13;" vertex="1" parent="1"><mxGeometry x="553" y="363" width="104" height="60" as="geometry"/></mxCell><mxCell id="3340-10" value="contains" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dcefe9;strokeColor=#0b7a6b;fontSize=13;" vertex="1" parent="1"><mxGeometry x="386" y="493" width="108" height="60" as="geometry"/></mxCell><mxCell id="3340-11" value="is of type" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dcefe9;strokeColor=#0b7a6b;fontSize=13;" vertex="1" parent="1"><mxGeometry x="710" y="493" width="120" height="60" as="geometry"/></mxCell><mxCell id="3340-12" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#142027;" edge="1" parent="1" source="3340-3" target="3340-8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="3340-13" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#142027;" edge="1" parent="1" source="3340-8" target="3340-4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="3340-14" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#142027;" edge="1" parent="1" source="3340-4" target="3340-9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="3340-15" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#142027;" edge="1" parent="1" source="3340-9" target="3340-5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="3340-16" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#142027;" edge="1" parent="1" source="3340-4" target="3340-10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="3340-17" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#142027;" edge="1" parent="1" source="3340-10" target="3340-6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="3340-18" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#142027;" edge="1" parent="1" source="3340-5" target="3340-11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="3340-19" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#142027;" edge="1" parent="1" source="3340-11" target="3340-7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="3340-20" value="1" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontColor=#0b7a6b;fontSize=14;" vertex="1" parent="1"><mxGeometry x="190" y="371" width="20" height="20" as="geometry"/></mxCell><mxCell id="3340-21" value="N" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontColor=#0b7a6b;fontSize=14;" vertex="1" parent="1"><mxGeometry x="340" y="371" width="20" height="20" as="geometry"/></mxCell><mxCell id="3340-22" value="N" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontColor=#0b7a6b;fontSize=14;" vertex="1" parent="1"><mxGeometry x="520" y="371" width="20" height="20" as="geometry"/></mxCell><mxCell id="3340-23" value="1" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontColor=#0b7a6b;fontSize=14;" vertex="1" parent="1"><mxGeometry x="670" y="371" width="20" height="20" as="geometry"/></mxCell><mxCell id="3340-24" value="M" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontColor=#0b7a6b;fontSize=14;" vertex="1" parent="1"><mxGeometry x="444" y="433" width="20" height="20" as="geometry"/></mxCell><mxCell id="3340-25" value="N" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontColor=#0b7a6b;fontSize=14;" vertex="1" parent="1"><mxGeometry x="444" y="603" width="20" height="20" as="geometry"/></mxCell><mxCell id="3340-26" value="N" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontColor=#0b7a6b;fontSize=14;" vertex="1" parent="1"><mxGeometry x="774" y="433" width="20" height="20" as="geometry"/></mxCell><mxCell id="3340-27" value="1" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontColor=#0b7a6b;fontSize=14;" vertex="1" parent="1"><mxGeometry x="774" y="603" width="20" height="20" as="geometry"/></mxCell><mxCell id="3340-28" value="WarehouseID" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#142027;fontSize=12;fontStyle=5;" vertex="1" parent="1"><mxGeometry x="18" y="275" width="104" height="36" as="geometry"/></mxCell><mxCell id="3340-29" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#142027;" edge="1" parent="1" source="3340-3" target="3340-28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="3340-30" value="Name" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#142027;fontSize=12;" vertex="1" parent="1"><mxGeometry x="156" y="280" width="68" height="36" as="geometry"/></mxCell><mxCell id="3340-31" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#142027;" edge="1" parent="1" source="3340-3" target="3340-30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="3340-32" value="Phone" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#142027;fontSize=12;" vertex="1" parent="1"><mxGeometry x="74" y="480" width="72" height="36" as="geometry"/></mxCell><mxCell id="3340-33" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#142027;" edge="1" parent="1" source="3340-3" target="3340-32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="3340-34" value="SupplyID" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#142027;fontSize=12;fontStyle=5;" vertex="1" parent="1"><mxGeometry x="341" y="275" width="88" height="36" as="geometry"/></mxCell><mxCell id="3340-35" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#142027;" edge="1" parent="1" source="3340-4" target="3340-34"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="3340-36" value="SupplyDate" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#142027;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="275" width="100" height="36" as="geometry"/></mxCell><mxCell id="3340-37" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#142027;" edge="1" parent="1" source="3340-4" target="3340-36"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="3340-38" value="StoreID" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#142027;fontSize=12;fontStyle=5;" vertex="1" parent="1"><mxGeometry x="650" y="275" width="80" height="36" as="geometry"/></mxCell><mxCell id="3340-39" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#142027;" edge="1" parent="1" source="3340-5" target="3340-38"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="3340-40" value="Address" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#142027;fontSize=12;" vertex="1" parent="1"><mxGeometry x="750" y="265" width="80" height="36" as="geometry"/></mxCell><mxCell id="3340-41" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#142027;" edge="1" parent="1" source="3340-5" target="3340-40"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="3340-42" value="Manager" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#142027;fontSize=12;" vertex="1" parent="1"><mxGeometry x="858" y="295" width="84" height="36" as="geometry"/></mxCell><mxCell id="3340-43" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#142027;" edge="1" parent="1" source="3340-5" target="3340-42"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="3340-44" value="SizeM2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#142027;fontSize=12;" vertex="1" parent="1"><mxGeometry x="887" y="375" width="76" height="36" as="geometry"/></mxCell><mxCell id="3340-45" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#142027;" edge="1" parent="1" source="3340-5" target="3340-44"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="3340-46" value="Quantity" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#142027;fontSize=12;" vertex="1" parent="1"><mxGeometry x="533" y="505" width="84" height="36" as="geometry"/></mxCell><mxCell id="3340-47" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#142027;" edge="1" parent="1" source="3340-10" target="3340-46"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="3340-48" value="ProductID" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#142027;fontSize=12;fontStyle=5;" vertex="1" parent="1"><mxGeometry x="239" y="605" width="92" height="36" as="geometry"/></mxCell><mxCell id="3340-49" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#142027;" edge="1" parent="1" source="3340-6" target="3340-48"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="3340-50" value="Name" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#142027;fontSize=12;" vertex="1" parent="1"><mxGeometry x="266" y="675" width="68" height="36" as="geometry"/></mxCell><mxCell id="3340-51" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#142027;" edge="1" parent="1" source="3340-6" target="3340-50"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="3340-52" value="Unit" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#142027;fontSize=12;" vertex="1" parent="1"><mxGeometry x="550" y="675" width="60" height="36" as="geometry"/></mxCell><mxCell id="3340-53" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#142027;" edge="1" parent="1" source="3340-6" target="3340-52"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="3340-54" value="TypeID" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#142027;fontSize=12;fontStyle=5;" vertex="1" parent="1"><mxGeometry x="865" y="605" width="80" height="36" as="geometry"/></mxCell><mxCell id="3340-55" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#142027;" edge="1" parent="1" source="3340-7" target="3340-54"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="3340-56" value="TypeName" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#142027;fontSize=12;" vertex="1" parent="1"><mxGeometry x="859" y="675" width="92" height="36" as="geometry"/></mxCell><mxCell id="3340-57" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#142027;" edge="1" parent="1" source="3340-7" target="3340-56"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="3340-58" value="&lt;span style=&quot;color:#5b6b73&quot;&gt;Notation (Chen): rectangle = entity · diamond = relationship · ellipse = attribute · underlined = primary key · 1 / N / M = cardinality&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="35" y="723" width="800" height="61" as="geometry"/></mxCell><mxCell id="3340-59" value="&lt;div style=&quot;font-weight:bold;font-size:14px;margin:6px 0 2px 0;text-align:left&quot;&gt;1. Entities and attributes&lt;/div&gt;&lt;ul style=&quot;margin:2px 0 6px 0;padding-left:20px;text-align:left&quot;&gt;&#xa;&lt;li style=&quot;margin:0 0 2px 0&quot;&gt;&lt;b&gt;STORE_TYPE&lt;/b&gt; (&lt;u&gt;TypeID&lt;/u&gt;, TypeName). A separate entity because &quot;in the future, there can be new store types&quot;: a new type is just a new row, no change to the tables.&lt;/li&gt;&#xa;&lt;li style=&quot;margin:0 0 2px 0&quot;&gt;&lt;b&gt;STORE&lt;/b&gt; (&lt;u&gt;StoreID&lt;/u&gt;, Address, Manager, SizeM2)&lt;/li&gt;&#xa;&lt;li style=&quot;margin:0 0 2px 0&quot;&gt;&lt;b&gt;WAREHOUSE&lt;/b&gt; (&lt;u&gt;WarehouseID&lt;/u&gt;, Name, Phone)&lt;/li&gt;&#xa;&lt;li style=&quot;margin:0 0 2px 0&quot;&gt;&lt;b&gt;SUPPLY&lt;/b&gt; (&lt;u&gt;SupplyID&lt;/u&gt;, SupplyDate). This is the &quot;supply activity&quot;.&lt;/li&gt;&#xa;&lt;li style=&quot;margin:0 0 2px 0&quot;&gt;&lt;b&gt;PRODUCT&lt;/b&gt; (&lt;u&gt;ProductID&lt;/u&gt;, Name, Unit). Products make up &quot;the list of products&quot; of a supply.&lt;/li&gt;&lt;/ul&gt;&#xa;&lt;div style=&quot;font-weight:bold;font-size:14px;margin:6px 0 2px 0;text-align:left&quot;&gt;2. Relations (relationships)&lt;/div&gt;&lt;ul style=&quot;margin:2px 0 6px 0;padding-left:20px;text-align:left&quot;&gt;&#xa;&lt;li style=&quot;margin:0 0 2px 0&quot;&gt;&lt;b&gt;is of type&lt;/b&gt;: STORE – STORE_TYPE&lt;/li&gt;&#xa;&lt;li style=&quot;margin:0 0 2px 0&quot;&gt;&lt;b&gt;delivers&lt;/b&gt;: WAREHOUSE – SUPPLY&lt;/li&gt;&#xa;&lt;li style=&quot;margin:0 0 2px 0&quot;&gt;&lt;b&gt;receives&lt;/b&gt;: SUPPLY – STORE&lt;/li&gt;&#xa;&lt;li style=&quot;margin:0 0 2px 0&quot;&gt;&lt;b&gt;contains&lt;/b&gt;: SUPPLY – PRODUCT, with relationship attribute &lt;b&gt;Quantity&lt;/b&gt;&lt;/li&gt;&lt;/ul&gt;&#xa;&lt;div style=&quot;font-weight:bold;font-size:14px;margin:6px 0 2px 0;text-align:left&quot;&gt;3. Relational cardinalities&lt;/div&gt;&lt;ul style=&quot;margin:2px 0 6px 0;padding-left:20px;text-align:left&quot;&gt;&#xa;&lt;li style=&quot;margin:0 0 2px 0&quot;&gt;&lt;b&gt;STORE_TYPE 1 : N STORE&lt;/b&gt; (is of type)&lt;/li&gt;&#xa;&lt;li style=&quot;margin:0 0 2px 0&quot;&gt;&lt;b&gt;WAREHOUSE 1 : N SUPPLY&lt;/b&gt; (delivers)&lt;/li&gt;&#xa;&lt;li style=&quot;margin:0 0 2px 0&quot;&gt;&lt;b&gt;STORE 1 : N SUPPLY&lt;/b&gt; (receives)&lt;/li&gt;&#xa;&lt;li style=&quot;margin:0 0 2px 0&quot;&gt;Together: &lt;b&gt;WAREHOUSE M : N STORE&lt;/b&gt; through SUPPLY (every warehouse can deliver to every store and every store can ask every warehouse).&lt;/li&gt;&#xa;&lt;li style=&quot;margin:0 0 2px 0&quot;&gt;&lt;b&gt;SUPPLY M : N PRODUCT&lt;/b&gt; (contains, with Quantity)&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="35" y="794" width="470" height="619" as="geometry"/></mxCell><mxCell id="3340-60" value="&lt;div style=&quot;font-weight:bold;font-size:14px;margin:6px 0 2px 0;text-align:left&quot;&gt;4. Constraints&lt;/div&gt;&lt;ul style=&quot;margin:2px 0 6px 0;padding-left:20px;text-align:left&quot;&gt;&#xa;&lt;li style=&quot;margin:0 0 2px 0&quot;&gt;&lt;b&gt;Primary keys&lt;/b&gt;: TypeID, StoreID, WarehouseID, SupplyID, ProductID; (SupplyID, ProductID) in SUPPLY_ITEM.&lt;/li&gt;&#xa;&lt;li style=&quot;margin:0 0 2px 0&quot;&gt;&lt;b&gt;Foreign keys&lt;/b&gt;: STORE.TypeID, SUPPLY.WarehouseID, SUPPLY.StoreID, SUPPLY_ITEM.SupplyID, SUPPLY_ITEM.ProductID.&lt;/li&gt;&#xa;&lt;li style=&quot;margin:0 0 2px 0&quot;&gt;&lt;b&gt;NOT NULL&lt;/b&gt;: store type, address, manager and size; warehouse name and phone; supply date.&lt;/li&gt;&#xa;&lt;li style=&quot;margin:0 0 2px 0&quot;&gt;&lt;b&gt;UNIQUE&lt;/b&gt;: TypeName; warehouse Name.&lt;/li&gt;&#xa;&lt;li style=&quot;margin:0 0 2px 0&quot;&gt;&lt;b&gt;CHECK&lt;/b&gt;: SizeM2 &amp;gt; 0, Quantity &amp;gt; 0.&lt;/li&gt;&#xa;&lt;li style=&quot;margin:0 0 2px 0&quot;&gt;&lt;b&gt;Participation&lt;/b&gt;: every store must have a type, and every supply must have a warehouse and a store (total participation). Every supply should contain at least one product (business rule).&lt;/li&gt;&lt;/ul&gt;&#xa;&lt;div style=&quot;font-weight:bold;font-size:14px;margin:6px 0 2px 0;text-align:left&quot;&gt;5. Meaning of relational cardinalities&lt;/div&gt;&lt;ul style=&quot;margin:2px 0 6px 0;padding-left:20px;text-align:left&quot;&gt;&#xa;&lt;li style=&quot;margin:0 0 2px 0&quot;&gt;&lt;b&gt;STORE_TYPE – STORE (1:N):&lt;/b&gt; one store type can be assigned to many stores; each store has exactly one type.&lt;/li&gt;&#xa;&lt;li style=&quot;margin:0 0 2px 0&quot;&gt;&lt;b&gt;WAREHOUSE – SUPPLY (1:N):&lt;/b&gt; one warehouse makes many supplies; each supply comes from exactly one warehouse.&lt;/li&gt;&#xa;&lt;li style=&quot;margin:0 0 2px 0&quot;&gt;&lt;b&gt;STORE – SUPPLY (1:N):&lt;/b&gt; one store receives many supplies; each supply goes to exactly one store. Together: WAREHOUSE M:N STORE.&lt;/li&gt;&#xa;&lt;li style=&quot;margin:0 0 2px 0&quot;&gt;&lt;b&gt;SUPPLY – PRODUCT (M:N):&lt;/b&gt; one supply contains many products (each with a quantity); one product can appear in many supplies.&lt;/li&gt;&lt;/ul&gt;&#xa;&lt;p style=&quot;margin:2px 0 6px 0;text-align:left&quot;&gt;&lt;i&gt;Alternative model: an M:N relationship &quot;supplies&quot; directly between WAREHOUSE and STORE with a date attribute, plus a link to PRODUCT. Modelling SUPPLY as an entity is clearer and maps more easily to tables.&lt;/i&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="525" y="794" width="470" height="676" as="geometry"/></mxCell><mxCell id="3340-61" value="6. Instances (3 examples for each entity)" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#142027;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="35" y="1480" width="700" height="30" as="geometry"/></mxCell><mxCell id="3340-62" value="&lt;b&gt;STORE_TYPE&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="35" y="1516" width="160" height="41" as="geometry"/></mxCell><mxCell id="3340-63" value="&lt;table style=&quot;border-collapse:collapse;font-size:11px;width:100%&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;TypeID&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;TypeName&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Shop-store&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;2&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Supermarket&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;3&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Discount&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;spacing=0;" vertex="1" parent="1"><mxGeometry x="35" y="1553" width="158" height="86" as="geometry"/></mxCell><mxCell id="3340-64" value="&lt;b&gt;WAREHOUSE&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="213" y="1516" width="374" height="41" as="geometry"/></mxCell><mxCell id="3340-65" value="&lt;table style=&quot;border-collapse:collapse;font-size:11px;width:100%&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;WarehouseID&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;Name&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;Phone&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Central Warehouse Skopje&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;02 3111 222&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;2&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Warehouse Bitola&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;047 222 333&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;3&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Warehouse Shtip&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;032 444 555&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;spacing=0;" vertex="1" parent="1"><mxGeometry x="213" y="1553" width="374" height="86" as="geometry"/></mxCell><mxCell id="3340-66" value="&lt;b&gt;PRODUCT&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="607" y="1516" width="217" height="41" as="geometry"/></mxCell><mxCell id="3340-67" value="&lt;table style=&quot;border-collapse:collapse;font-size:11px;width:100%&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;ProductID&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;Name&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;Unit&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Milk 1L&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;pcs&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;2&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Bread 500g&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;pcs&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;3&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Apples&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;kg&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;spacing=0;" vertex="1" parent="1"><mxGeometry x="607" y="1553" width="217" height="86" as="geometry"/></mxCell><mxCell id="3340-68" value="&lt;b&gt;STORE&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="35" y="1653" width="485" height="41" as="geometry"/></mxCell><mxCell id="3340-69" value="&lt;table style=&quot;border-collapse:collapse;font-size:11px;width:100%&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;StoreID&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;Address&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;Manager&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;SizeM2&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;TypeID&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;101&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Partizanska 12, Skopje&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Ana Petrova&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;120&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;102&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Bul. Ilinden 45, Skopje&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Marko Iliev&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;850&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;103&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Goce Delchev 8, Bitola&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Elena Stojanova&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;400&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;3&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;spacing=0;" vertex="1" parent="1"><mxGeometry x="35" y="1690" width="485" height="86" as="geometry"/></mxCell><mxCell id="3340-70" value="&lt;b&gt;SUPPLY&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="35" y="1790" width="324" height="41" as="geometry"/></mxCell><mxCell id="3340-71" value="&lt;table style=&quot;border-collapse:collapse;font-size:11px;width:100%&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;SupplyID&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;SupplyDate&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;WarehouseID&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;StoreID&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;1001&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;2026-11-01&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;101&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;1002&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;2026-11-02&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;2&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;103&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;1003&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;2026-11-02&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;102&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;spacing=0;" vertex="1" parent="1"><mxGeometry x="35" y="1827" width="324" height="86" as="geometry"/></mxCell><mxCell id="3340-72" value="&lt;b&gt;SUPPLY_ITEM (contains)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="379" y="1790" width="230" height="41" as="geometry"/></mxCell><mxCell id="3340-73" value="&lt;table style=&quot;border-collapse:collapse;font-size:11px;width:100%&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;SupplyID&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;ProductID&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;Quantity&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;1001&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;50&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;1001&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;2&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;30&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;1002&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;3&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;120&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;1003&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;200&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;spacing=0;" vertex="1" parent="1"><mxGeometry x="379" y="1827" width="230" height="106" as="geometry"/></mxCell><mxCell id="3340-74" value="Bonus: the same model as tables (relational model)" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#142027;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="35" y="1957" width="700" height="30" as="geometry"/></mxCell><mxCell id="3340-75" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot;&gt;&lt;tr&gt;&lt;th colspan=&quot;3&quot; style=&quot;background:#0b7a6b;color:#fff;padding:4px;font-size:12px&quot;&gt;STORE_