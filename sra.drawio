;startArrow=none;strokeColor=#142027;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="320.0" y="226.8" as="sourcePoint"/><mxPoint x="320.0" y="306.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="8193-27" value="room data" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="326" y="259" width="73" height="15" as="geometry"/></mxCell><mxCell id="8193-28" value="" style="html=1;rounded=0;endFill=1;endArrow=block;endFill=1;endSize=8;startArrow=none;strokeColor=#142027;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="378.0" y="364.8" as="sourcePoint"/><mxPoint x="460.0" y="364.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="8193-29" value="new booking" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="376" y="346" width="87" height="15" as="geometry"/></mxCell><mxCell id="8193-30" value="" style="html=1;rounded=0;endFill=1;endArrow=block;endFill=1;endSize=8;startArrow=block;startFill=1;startSize=8;strokeColor=#142027;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600.0" y="354.8" as="sourcePoint"/><mxPoint x="692.8" y="288.5" as="targetPoint"/></mxGeometry></mxCell><mxCell id="8193-31" value="request /&lt;br&gt;status" style="text;html=1;align=right;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="563" y="290" width="73" height="30" as="geometry"/></mxCell><mxCell id="8193-32" value="" style="html=1;rounded=0;endFill=1;endArrow=block;endFill=1;endSize=8;startArrow=none;strokeColor=#142027;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600.0" y="374.8" as="sourcePoint"/><mxPoint x="692.8" y="441.1" as="targetPoint"/></mxGeometry></mxCell><mxCell id="8193-33" value="booking data" style="text;html=1;align=right;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="542" y="423" width="94" height="15" as="geometry"/></mxCell><mxCell id="8193-34" value="" style="html=1;rounded=0;endFill=1;endArrow=block;endFill=1;endSize=8;startArrow=none;strokeColor=#142027;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="877.5" y="343.8" as="sourcePoint"/><mxPoint x="788.7" y="286.3" as="targetPoint"/></mxGeometry></mxCell><mxCell id="8193-35" value="decision" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="838" y="295" width="66" height="15" as="geometry"/></mxCell><mxCell id="8193-36" value="" style="html=1;rounded=0;endFill=1;endArrow=block;endFill=1;endSize=8;startArrow=none;strokeColor=#142027;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="788.7" y="443.3" as="sourcePoint"/><mxPoint x="877.5" y="385.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="8193-37" value="usage report" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="838" y="429" width="94" height="15" as="geometry"/></mxCell><mxCell id="8193-38" value="&lt;p style=&quot;margin:2px 0 6px 0;text-align:left&quot;&gt;Секој процес има број и влез и излез. Студентот не пишува директно во D2 Bookings: барањето минува низ процесот 1.0.&lt;/p&gt;&lt;p style=&quot;margin:2px 0 6px 0;text-align:left&quot;&gt;Складовите D1 Rooms и D2 Bookings се совпаѓаат со ентитетите Room и Booking од ERD. Тоа е проверката „DFD data objects → ERD entities“ од L4 script p.5–6.&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="575" width="900" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="6862-45" name="7 · Decision table"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="612" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="6862-1" value="7 · Decision table" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#142027;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="900" height="34" as="geometry"/></mxCell><mxCell id="6862-2" value="&lt;span style=&#x27;color:#5b6b73&#x27;&gt;Табела на одлуки (Decision table)&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="32" width="900" height="41" as="geometry"/></mxCell><mxCell id="6862-3" value="&lt;b&gt;Scenario:&lt;/b&gt; &lt;i&gt;Room Booking System (Exercise 4), approval logic: if the room is not available, show “not available”. If it is available and does not require approval, confirm. If it requires approval, staff bookings are confirmed directly and student bookings are sent to the administrator.&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="73" width="900" height="87" as="geometry"/></mxCell><mxCell id="6862-4" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=#dcefe9;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="50" y="186" width="550" height="34" as="geometry"/></mxCell><mxCell id="6862-5" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=#dcefe9;strokeWidth=1;" ve