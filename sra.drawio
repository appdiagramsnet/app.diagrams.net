"499.1" y="363.8" as="sourcePoint"/><mxPoint x="635.0" y="363.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="6174-21" value="approval request,&lt;br&gt;usage report" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="503" y="327" width="128" height="30" as="geometry"/></mxCell><mxCell id="6174-22" value="" style="html=1;rounded=0;endFill=1;endArrow=block;endFill=1;endSize=8;startArrow=none;strokeColor=#142027;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="420.0" y="295.8" as="sourcePoint"/><mxPoint x="420.0" y="241.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="6174-23" value="notification" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="428" y="261" width="94" height="15" as="geometry"/></mxCell><mxCell id="6174-24" value="" style="html=1;rounded=0;endFill=1;endArrow=block;endFill=1;endSize=8;startArrow=none;strokeColor=#142027;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="420.0" y="509.8" as="sourcePoint"/><mxPoint x="420.0" y="455.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="6174-25" value="room schedule" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="428" y="476" width="100" height="15" as="geometry"/></mxCell><mxCell id="6174-26" value="&lt;p style=&quot;margin:2px 0 6px 0;text-align:left&quot;&gt;Целиот систем е еден круг. Секој надворешен ентитет има именувани стрелки во двете насоки каде што е потребно.&lt;/p&gt;&lt;p style=&quot;margin:2px 0 6px 0;text-align:left&quot;&gt;E-mail Service и Timetable System се надворешни &lt;em&gt;системи&lt;/em&gt;: и тие се надворешни ентитети, исто како секундарните актери во use case дијаграмот.&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="591" width="900" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="8193-39" name="6 · Data flow diagram (Level 0)"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1025" pageHeight="745" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="8193-1" value="6 · Data flow diagram (Level 0)" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#142027;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="900" height="34" as="geometry"/></mxCell><mxCell id="8193-2" value="&lt;span style=&#x27;color:#5b6b73&#x27;&gt;Дијаграм на тек на податоци, ниво 0 (Data Flow Diagram, Level 0)&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="32" width="900" height="41" as="geometry"/></mxCell><mxCell id="8193-3" value="&lt;b&gt;Scenario:&lt;/b&gt; &lt;i&gt;Room Booking System (Exercise 4), Level 0: the system is split into Manage Bookings, Approve Booking and Generate Reports, with the data stores Rooms and Bookings.&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="73" width="900" height="66" as="geometry"/></mxCell><mxCell id="8193-4" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="344" width="120" height="42" as="geometry"/></mxCell><mxCell id="8193-5" value="Student" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle