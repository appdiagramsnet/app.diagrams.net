ry"><mxPoint x="452.0" y="333.9" as="sourcePoint"/><mxPoint x="452.0" y="244.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="5520-26" value="attendee list" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="458" y="284" width="100" height="15" as="geometry"/></mxCell><mxCell id="5520-27" value="" style="html=1;rounded=0;endFill=1;endArrow=block;endFill=1;endSize=8;startArrow=none;strokeColor=#142027;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="370.5" y="466.9" as="sourcePoint"/><mxPoint x="199.8" y="587.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="5520-28" value="membership report" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="246" y="555" width="128" height="15" as="geometry"/></mxCell><mxCell id="5520-29" value="" style="html=1;rounded=0;endFill=1;endArrow=block;endFill=1;endSize=8;startArrow=none;strokeColor=#142027;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="659.3" y="587.0" as="sourcePoint"/><mxPoint x="501.9" y="476.2" as="targetPoint"/></mxGeometry></mxCell><mxCell id="5520-30" value="card scan" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="528" y="547" width="73" height="15" as="geometry"/></mxCell><mxCell id="5520-31" value="" style="html=1;rounded=0;endFill=1;endArrow=block;endFill=1;endSize=8;startArrow=none;strokeColor=#142027;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515.7" y="456.6" as="sourcePoint"/><mxPoint x="701.0" y="587.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="5520-32" value="open / deny signal" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="567" y="478" width="135" height="15" as="geometry"/></mxCell><mxCell id="5520-33" value="&lt;div style=&quot;font-weight:bold;font-size:14px;margin:6px 0 2px 0;text-align:left&quot;&gt;Решение&lt;/div&gt;&lt;p style=&quot;margin:2px 0 6px 0;text-align:left&quot;&gt;Кругот „Gym Membership System“ е опкружен со Member, Trainer, Gym Manager, Payment System и Access Gate. Секој тек е именуван и има правилна насока (на пр. „card scan“ кон системот, „open / deny signal“ кон портата).&lt;/p&gt;&lt;p style=&quot;margin:2px 0 6px 0;text-align:left&quot;&gt;Ако задачата бара DFD ниво 0, кругот се дели на процеси (1.0 Manage Memberships, 2.0 Manage Classes, 3.0 Control Access, 4.0 Produce Reports) со складови D1 Members, D2 Classes, D3 Bookings. Истите надворешни текови мора да останат (balancing).&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="673" width="900" height="177" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="7201-48" name="P10 · Библиотека"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="697" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="7201-1" value="P10 · Библиотека: табела на одлуки за позајмување" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#142027;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1000" height="32" as="geometry"/></mxCell><mxCell id="7201-2" value="&lt;b&gt;Scenario:&lt;/b&gt; &lt;i&gt;Library loan rules: a loan is refused if the membership is not active; the member is then asked to renew the membership. If the membership is active but the member has overdue books, the loan is refused and the member is asked to return the overdue books first. If the member already has 5 books on loan, the loan is refused. Otherwise the loan is approved.&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Task:&lt;/b&gt; &lt;i&gt;Draw a decision table for the loan rules. Use “–” for conditions that do not matter.&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="38" width="900" height="108" as="geometry"/></mxCell><mxCell id="7201-3" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=#dcefe9;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="50" y="172" width="560" height="34" as="geometry"/></mxCell><mxCell id="7201-4" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=#dcefe9;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="50" y="206" width="280" height="224" as="geometry"/></mxCell><mxCell id="7201-5" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=none;strokeWidth=1.8;" vertex="1" parent="1"><mxGeometry x="50" y="172" width="560" height="258" as="geometry"/></mxCell><mxCell id="7201-6" value="" style="html=1;rounded=0;endFill=1;endArrow=none;startArrow=none;strokeColor=#142027;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330.0" y="172.0" as="sourcePoint"/><mxPoint x="330.0" y="430.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="7201-7" value="" style="html=1;rounded=0;endFill=1;endArrow=none;startArrow=none;strokeColor=#142027;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400.0" y="172.0" as="sourcePoint"/><mxPoint x="400.0" y="430.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="7201-8" value="" style="html=1;rounded=0;endFill=1;endArrow=none;startArrow=none;strokeColor=#142027;strokeWidth=1;" edge="1" parent="1"><mxGeometr