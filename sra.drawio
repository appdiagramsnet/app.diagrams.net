height="21" as="geometry"/></mxCell><mxCell id="4967-48" value="teaches" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="741" y="330" width="59" height="15" as="geometry"/></mxCell><mxCell id="4967-49" value="" style="html=1;rounded=0;endFill=1;endArrow=none;startArrow=none;strokeColor=#142027;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="735.0" y="491.0" as="sourcePoint"/><mxPoint x="735.0" y="563.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="4967-50" value="1" style="text;html=1;align=right;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#0b7a6b;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="711" y="498" width="18" height="18" as="geometry"/></mxCell><mxCell id="4967-51" value="*" style="text;html=1;align=right;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#0b7a6b;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="709" y="539" width="20" height="21" as="geometry"/></mxCell><mxCell id="4967-52" value="contains" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="741" y="520" width="66" height="15" as="geometry"/></mxCell><mxCell id="4967-53" value="&lt;div style=&quot;font-weight:bold;font-size:14px;margin:6px 0 2px 0;text-align:left&quot;&gt;Решение&lt;/div&gt;&lt;p style=&quot;margin:2px 0 6px 0;text-align:left&quot;&gt;Ентитети: Student, Instructor, Course, Lesson и &lt;strong&gt;Enrollment&lt;/strong&gt;. Enrollment ја разложува many-to-many врската Student–Course и ги чува EnrollDate и FinalGrade, исто како Booking во E4.&lt;/p&gt;&lt;p style=&quot;margin:2px 0 6px 0;text-align:left&quot;&gt;Врски: Student 1—* Enrollment, Course 1—* Enrollment, Instructor 1—* Course (FK InstructorID во Course), Course 1—* Lesson (FK CourseID во Lesson).&lt;/p&gt;&lt;p style=&quot;margin:2px 0 6px 0;text-align:left&quot;&gt;Грешка: FinalGrade ставен во Student или во Course. Оцената зависи и од студентот и од курсот.&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="723" width="900" height="212" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="2677-35" name="P7 · Нарачка храна"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="679" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2677-1" value="P7 · Нарачка храна: дијаграм на состојби" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#142027;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1000" height="32" as="geometry"/></mxCell><mxCell id="2677-2" value="&lt;b&gt;Scenario:&lt;/b&gt; &lt;i&gt;In FoodNow, an order is Placed by the customer. The restaurant either accepts it or rejects it. An accepted order goes Out for Delivery when the courier picks it up and becomes Delivered when the courier confirms delivery. The customer can cancel an order while it is Placed or Accepted, but not after it is out for delivery.&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Task:&lt;/b&gt; &lt;i&gt;Draw a state-transition diagram for an order.&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="38" width="900" height="108" as="geometry"/></mxCell><mxCell id="2677-3" value="" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=#142027;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="57" y="204" width="16" height="16" as="geometry"/></mxCell><mxCell id="2677-4" value="" style="rounded=1;absoluteArcSize=1;arcSize=28.0;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=#dcefe9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="80" y="190" width="130" height="44" as="geometry"/></mxCell><mxCell id="2677-5" value="Placed" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="117" y="204" width="55" height="16" as="geometry"/></mxCell><mxCell id="2677-6" value="" style="rounded=1;absoluteArcSize=1;arcSize=28.0;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=#dcefe9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="320" y="190" width="130" height="44" as="geometry"/></mxCell><mxCell id="2677-7" value="Accepted" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="350" y="204" width="70" height="16" as="geometry"/></mxCell><mxCell id="2677-8" value="" style="rounded=1;absoluteArcSize=1;arcSize=28.0;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=#dcefe9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="550" y="190" width="150" height="44" as="geometry"/></mxCell><mxCell id="2677-9" value="Out for&lt;br&gt;Delivery" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="590" y="196" width="70" height="32" as="geometry"/></mxCell><mxCell id="2677-10" value="" style="rounded=1;absoluteArcSize=1;arcSize=28.0;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=#dcefe9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="790" y="190" width="130" height="44" as="geometry"/></mxCell><mxCell id="2677-11" value="Delivered" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="816" y="204" width="78" height="16" as="geometry"/></mxCell><mxCell id="2677-12" value="" style="rounded=1;absoluteArcSize=1;arcSize=28.0;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=#dcefe9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="80" y="325" width="130" height="44" as="geometry"/></mxCell><mxCell id="2677-13" value="Rejected" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="110" y="339" width="70" height="16" as="geometry"/></mxCell><mxCell id="2677-14" value="" style="rounded=1;absoluteArcSize=1;arcSize=28.0;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=#dcefe9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="320" y="325" width="130" height="44" as="geometry"/></mxCell><mxCell id="2677-15" value="Cancelled" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="346" y="339" width="78" height="16" as="geometry"/></mxCell><mxCell id="2677-16" value="" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=none;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="843" y="335" width="24" height="24" as="geometry"/></mxCell><mxCell id="2677-17" value="" style="ellipse;whiteSpace=wrap;html=1;strokeColor=none;fillColor=#142027;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="848" y="340" width="14" height="14" as="geometry"/></mxCell><mxCell id="2677-18" value="" style="html=1;rounded=0;endFill=1;endArrow=block;endFill=1;endSize=8;startArrow=none;strokeColor=#142027;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="73.0" y="212.0" as="sourcePoint"/><mxPoint x="80.0" y="212.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="2677-19" value="" style="html=1;rounded=0;endFill=1;endArrow=block;endFill=1;endSize=8;startArrow=none;strokeColor=#142027;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="210.0" y="212.0" as="sourcePoint"/><mxPoint x="320.0" y="212.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="2677-20" value="restaurant&lt;br&gt;accepts" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="225" y="175" width="80" height="30" as="geometry"/></mxCell><mxCell id="2677-21" value="" style="html=1;rounded=0;endFill=1;endArrow=block;endFill=1;endSize=8;startArrow=none;strokeColor=#142027;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450.0" y="212.0" as="sourcePoint"/><mxPoint x="550.0" y="212.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="2677-22" value="courier&lt;br&gt;picks up" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="452" y="175" width="66" height="30" as="geometry"/></mxCell><mxCell id="2677-23" value="" style="html=1;rounded=0;endFill=1;endArrow=block;endFill=1;endSize=8;startArrow=none;strokeColor=#142027;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700.0" y="212.0" as="sourcePoint"/><mxPoint x="790.0" y="212.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="2677-24" value="courier&lt;br&gt;confirms" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="712" y="175" width="66" height="30" as="geometry"/></mxCell><mxCell id="2677-25" value="" style="html=1;rounded=0;endFill=1;endArrow=block;endFill=1;endSize=8;startArrow=none;strokeColor=#142027;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="145.0" y="234.0" as="sourcePoint"/><mxPoint x="145.0" y="325.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="2677-26" value="restaurant&lt;br&gt;rejects" style="text;html=1;align=right;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="57" y="265" width="80" height="30" as="geometry"/></mxCell><mxCell id="2677-27" value="" style="html=1;rounded=0;endFill=1;endArrow=block;endFill=1;endSize=8;startArrow=none;strokeColor=#142027;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="385.0" y="234.0" as="sourcePoint"/><mxPoint x="385.0" y="325.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="2677-28" value="customer cancels" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="391" y="272" width="121" height="15" as="geometry"/></mxCell><mxCell id="2677-29" value="" style="html=1;rounded=0;endFill=1;endArrow=block;endFill=1;endSize=8;startArrow=none;strokeColor=#142027;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="184.1" y="234.0" as="sourcePoint"/><mxPoint x="345.9" y="325.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="2677-30" value="customer cancels" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="225" y="244" width="121" height="15" as="geometry"/></mxCell><mxCell id="2677-31" value="" style="html=1;rounded=0;endFill=1;endArrow=block;endFill=1;endSize=8;startArrow=none;strokeColor=#142027;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450.0" y="347.0" as="sourcePoint"/><mxPoint x="843.0" y="347.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="2677-32" value="" style="html=1;rounded=0;endFill=1;endArrow=block;endFill=1;endSize=8;startArrow=none;strokeColor=#142027;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="855.0" y="234.0" as="sourcePoint"/><mxPoint x="855.0" y="335.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="2677-33" value="" style="html=1;rounded=0;endFill=1;endArrow=block;endFill=1;endSize=8;startArrow=none;strokeColor=#142027;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="145.0" y="369.0" as="sourcePoint"/><mxPoint x="855.0" y="359.0" as="targetPoint"/><Array as="points"><mxPoint x="145.0" y="407.0"/><mxPoint x="855.0" y="407.0"/></Array></mxGeometry></mxCell><mxCell id="2677-34" value="&lt;div style=&quot;font-weight:bold;font-size:14px;margin:6px 0 2px 0;text-align:left&quot;&gt;Решение&lt;/div&gt;&lt;p style=&quot;margin:2px 0 6px 0;text-align:left&quot;&gt;Почеток → Placed. Placed → Accepted („restaurant accepts“) или → Rejected („restaurant rejects“). Accepted → Out for Delivery („courier picks up“) → Delivered („courier confirms“).&lt;/p&gt;&lt;p style=&quot;margin:2px 0 6px 0;text-align:left&quot;&gt;„customer cancels“ од Placed и од Accepted кон Cancelled. Од Out for Delivery НЕМА стрелка кон Cancelled; тоа е правилото од текстот. Rejected, Cancelled и Delivered водат кон крајната состојба.&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="442" width="900" height="177" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="7895-56" name="P8 · Болница"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1040" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="7895-1" value="P8 · Болница: swimlane за телефонско закажување" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#142027;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1000" height="32" as="geometry"/></mxCell><mxCell id="7895-2" value="&lt;b&gt;Scenario:&lt;/b&gt; &lt;i&gt;A patient calls the hospital to book an appointment. The receptionist asks for the patient ID and the hospital system searches for the patient record. If the patient is not registered, the receptionist registers the patient first. The system then finds free slots. If no slot is suitable, the receptionist offers another date and the system searches again. When a slot is chosen, the system saves the appointment and sends an SMS confirmation, which the patient receives.&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Task:&lt;/b&gt; &lt;i&gt;Draw a swimlane diagram (activity diagram with lanes) for this process.&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="38" width="900" height="129" as="geometry"/></mxCell><mxCell id="7895-3" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="50" y="193" width="190" height="580" as="geometry"/></mxCell><mxCell id="7895-4" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=#dcefe9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="50" y="193" width="190" height="34" as="geometry"/></mxCell><mxCell id="7895-5" value="Patient" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="114" y="202" width="63" height="16" as="geometry"/></mxCell><mxCell id="7895-6" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="240" y="193" width="230" height="580" as="geometry"/></mxCell><mxCell id="7895-7" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=#dcefe9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="240" y="193" width="230" height="34" as="geometry"/></mxCell><mxCell id="7895-8" value="Receptionist" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="305" y="202" width="100" height="16" as="geometry"/></mxCell><mxCell id="7895-9" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="470" y="193" width="270" height="580" as="geometry"/></mxCell><mxCell id="7895-10" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=#dcefe9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="470" y="193" width="270" height="34" as="geometry"/></mxCell><mxCell id="7895-11" value="Hospital System" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="543" y="202" width="123" height="16" as="geometry"/></mxCell><mxCell id="7895-12" value="" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=#142027;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="137" y="247" width="16" height="16" as="geometry"/></mxCell><mxCell id="7895-13" value="" style="rounded=1;absoluteArcSize=1;arcSize=20.0;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="80" y="285" width="130" height="36" as="geometry"/></mxCell><mxCell id="7895-14" value="Call hospital" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="95" y="296" width="100" height="15" as="geometry"/></mxCell><mxCell id="7895-15" value="" style="rounded=1;absoluteArcSize=1;arcSize=20.0;whiteSpace