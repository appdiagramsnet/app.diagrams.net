 style="html=1;rounded=0;endFill=1;endArrow=none;startArrow=none;strokeColor=#142027;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="50.0" y="366.0" as="sourcePoint"/><mxPoint x="610.0" y="366.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="7201-16" value="" style="html=1;rounded=0;endFill=1;endArrow=none;startArrow=none;strokeColor=#142027;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="50.0" y="398.0" as="sourcePoint"/><mxPoint x="610.0" y="398.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="7201-17" value="Conditions / Actions" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="110" y="181" width="161" height="16" as="geometry"/></mxCell><mxCell id="7201-18" value="R1" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="352" y="181" width="25" height="16" as="geometry"/></mxCell><mxCell id="7201-19" value="R2" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="422" y="181" width="25" height="16" as="geometry"/></mxCell><mxCell id="7201-20" value="R3" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="492" y="181" width="25" height="16" as="geometry"/></mxCell><mxCell id="7201-21" value="R4" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="562" y="181" width="25" height="16" as="geometry"/></mxCell><mxCell id="7201-22" value="C1  Membership active?" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="58" y="214" width="176" height="16" as="geometry"/></mxCell><mxCell id="7201-23" value="N" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="356" y="214" width="18" height="16" as="geometry"/></mxCell><mxCell id="7201-24" value="Y" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="426" y="214" width="18" height="16" as="geometry"/></mxCell><mxCell id="7201-25" value="Y" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="496" y="214" width="18" height="16" as="geometry"/></mxCell><mxCell id="7201-26" value="Y" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="566" y="214" width="18" height="16" as="geometry"/></mxCell><mxCell id="7201-27" value="C2  Has overdue books?" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="58" y="246" width="176" height="16" as="geometry"/></mxCell><mxCell id="7201-28" value="–" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="356" y="246" width="18" height="16" as="geometry"/></mxCell><mxCell id="7201-29" value="Y" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="426" y="246" width="18" height="16" as="geometry"/></mxCell><mxCell id="7201-30" value="N" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="496" y="246" width="18" height="16" as="geometry"/></mxCell><mxCell id="7201-31" value="N" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="566" y="246" width="18" height="16" as="geometry"/></mxCell><mxCell id="7201-32" value="C3  Already 5 books on loan?" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="58" y="278" width="221" height="16" as="geometry"/></mxCell><mxCell id="7201-33" value="–" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="356" y="278" width="18" height="16" as="geometry"/></mxCell><mxCell id="7201-34" value="–" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="426" y="278" width="18" height="16" as="geometry"/></mxCell><mxCell id="7201-35" value="Y" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="496" y="278" width="18" height="16" as="geometry"/></mxCell><mxCell id="7201-36" value="N" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="566" y="278" width="18" height="16" as="geometry"/></mxCell><mxCell id="7201-37" value="A1  Approve loan" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="58" y="310" width="131" height="16" as="geometry"/></mxCell><mxCell id="7201-38" value="X" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="566" y="310" width="18" height="16" as="geometry"/></mxCell><mxCell id="7201-39" value="A2  Refuse loan" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="58" y="342" width="123" height="16" as="geometry"/></mxCell><mxCell id="7201-40" value="X" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="356" y="342" width="18" height="16" as="geometry"/></mxCell><mxCell id="7201-41" value="X" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="426" y="342" width="18" height="16" as="geometry"/></mxCell><mxCell id="7201-42" value="X" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="496" y="342" width="18" height="16" as="geometry"/></mxCell><mxCell id="7201-43" value="A3  Ask to renew membership" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="58" y="374" width="214" height="16" as="geometry"/></mxCell><mxCell id="7201-44" value="X" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="356" y="374" width="18" height="16" as="geometry"/></mxCell><mxCell id="7201-45" value="A4  Ask to return overdue books" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="58" y="406" width="244" height="16" as="geometry"/></mxCell><mxCell id="7201-46" value="X" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="426" y="406" width="18" height="16" as="geometry"/></mxCell><mxCell id="7201-47" value="&lt;div style=&quot;font-weight:bold;font-size:14px;margin:6px 0 2px 0;text-align:left&quot;&gt;Решение&lt;/div&gt;&lt;p style=&quot;margin:2px 0 6px 0;text-align:left&quot;&gt;Услови: C1 Membership active?, C2 Has overdue books?, C3 Already 5 books on loan?. Акции: A1 Approve loan, A2 Refuse loan, A3 Ask to renew membership, A4 Ask to return overdue books.&lt;/p&gt;&lt;p style=&quot;margin:2px 0 6px 0;text-align:left&quot;&gt;R1 (N/–/–) → A2 + A3; R2 (Y/Y/–) → A2 + A4; R3 (Y/N/Y) → A2; R4 (Y/N/N) → A1. R1 покрива 4 комбинации, R2 покрива 2, а R3 и R4 по 1: вкупно 8, без празнини и без контрадикции.&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="900" height="177" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>