" style="html=1;rounded=0;endFill=1;endArrow=block;endFill=1;endSize=8;startArrow=none;strokeColor=#142027;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="370.0" y="240.8" as="sourcePoint"/><mxPoint x="340.0" y="240.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="6386-38" value="" style="html=1;rounded=0;endFill=1;endArrow=block;endFill=1;endSize=8;startArrow=none;strokeColor=#142027;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490.0" y="360.8" as="sourcePoint"/><mxPoint x="540.0" y="360.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="6386-39" value="Yes" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="500" y="343" width="31" height="15" as="geometry"/></mxCell><mxCell id="6386-40" value="" style="html=1;rounded=0;endFill=1;endArrow=block;endFill=1;endSize=8;startArrow=none;strokeColor=#142027;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600.0" y="394.8" as="sourcePoint"/><mxPoint x="600.0" y="465.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="6386-41" value="Yes" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="606" y="396" width="31" height="15" as="geometry"/></mxCell><mxCell id="6386-42" value="" style="html=1;rounded=0;endFill=1;endArrow=block;endFill=1;endSize=8;startArrow=none;strokeColor=#142027;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="660.0" y="360.8" as="sourcePoint"/><mxPoint x="690.0" y="360.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="6386-43" value="No" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="663" y="343" width="24" height="15" as="geometry"/></mxCell><mxCell id="6386-44" value="" style="html=1;rounded=0;endFill=1;endArrow=block;endFill=1;endSize=8;startArrow=none;strokeColor=#142027;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="670.0" y="485.8" as="sourcePoint"/><mxPoint x="755.0" y="380.8" as="targetPoint"/><Array as="points"><mxPoint x="755.0" y="485.8"/></Array></mxGeometry></mxCell><mxCell id="6386-45" value="" style="html=1;rounded=0;endFill=1;endArrow=block;endFill=1;endSize=8;startArrow=none;strokeColor=#142027;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="755.0" y="340.8" as="sourcePoint"/><mxPoint x="755.0" y="260.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="6386-46" value="" style="html=1;rounded=0;endFill=1;endArrow=block;endFill=1;endSize=8;startArrow=none;strokeColor=#142027;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820.0" y="240.8" as="sourcePoint"/><mxPoint x="839.0" y="240.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="6386-47" value="&lt;p style=&quot;margin:2px 0 6px 0;text-align:left&quot;&gt;Три ленти = три учесници. Двете одлуки се ромбови со означени гранки. „Available? No“ е &lt;strong&gt;исклучокот&lt;/strong&gt; од E4 sol p.2 (4b–6b, студентот избира друг термин), а „Approval needed? Yes“ е &lt;strong&gt;алтернативниот тек&lt;/strong&gt; 4a–7a.&lt;/p&gt;&lt;p style=&quot;margin:2px 0 6px 0;text-align:left&quot;&gt;Истиот use case „Book a Room“ е овде нацртан како тек низ улогите. Затоа swimlane е добар избор кога текстот вели „workflow across departments“.&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="576" width="900" height="135" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="6174-27" name="5 · Context diagram"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="761" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="6174-1" value="5 · Context diagram" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#142027;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="900" height="34" as="geometry"/></mxCell><mxCell id="6174-2" value="&lt;span style=&#x27;color:#5b6b73&#x27;&gt;Контекст дијаграм (Context diagram)&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="32" width="900" height="41" as="geometry"/></mxCell><mxCell id="6174-3" value="&lt;b&gt;Scenario:&lt;/b&gt; &lt;i&gt;Room Booking System (Exercise 4): students send booking requests and cancellations and receive availability and confirmations; administrators receive approval requests and usage reports and send approval decisions; an e-mail service delivers notifications; the university timetable system provides the room schedule.&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="73" width="900" height="87" as="geometry"/></mxCell><mxCell id="6174-4" value="" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=#dcefe9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="340" y="296" width="160" height="160" as="geometry"/></mxCell><mxCell id="6174-5" value="Room Booking&lt;br&gt;System" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="366" y="359" width="107" height="34" as="geometry"/></mxCell><mxCell id="6174-6" value="" style="rounded=0;whiteSpace=wrap;html=1;stro