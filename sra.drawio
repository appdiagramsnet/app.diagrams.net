="1229-46" value="«include»" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#0b7a6b;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="392" y="416" width="73" height="15" as="geometry"/></mxCell><mxCell id="1229-47" value="" style="html=1;rounded=0;endFill=1;endArrow=open;endSize=8;startArrow=none;strokeColor=#142027;strokeWidth=1.5;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="371.3" y="492.8" as="sourcePoint"/><mxPoint x="490.2" y="470.3" as="targetPoint"/></mxGeometry></mxCell><mxCell id="1229-48" value="«include»" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#0b7a6b;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="397" y="489" width="73" height="15" as="geometry"/></mxCell><mxCell id="1229-49" value="" style="html=1;rounded=0;endFill=1;endArrow=open;endSize=8;startArrow=none;strokeColor=#142027;strokeWidth=1.5;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="483.3" y="593.4" as="sourcePoint"/><mxPoint x="368.7" y="583.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="1229-50" value="«extend»" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#0b7a6b;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="394" y="569" width="66" height="15" as="geometry"/></mxCell><mxCell id="1229-51" value="&lt;div style=&quot;font-weight:bold;font-size:14px;margin:6px 0 2px 0;text-align:left&quot;&gt;Решение&lt;/div&gt;&lt;p style=&quot;margin:2px 0 6px 0;text-align:left&quot;&gt;&lt;strong&gt;Актери:&lt;/strong&gt; Member (примарен), Librarian (примарен) и E-mail Service (секундарен, надворешен систем, десно).&lt;/p&gt;&lt;p style=&quot;margin:2px 0 6px 0;text-align:left&quot;&gt;&lt;strong&gt;Use case-и:&lt;/strong&gt; Search Catalogue, Reserve Book, Renew Loan (Member); Check Out Book, Return Book, Manage Catalogue (Librarian).&lt;/p&gt;&lt;p style=&quot;margin:2px 0 6px 0;text-align:left&quot;&gt;&lt;strong&gt;«include»:&lt;/strong&gt; Reserve Book, Renew Loan и Check Out Book → Verify Member Account, бидејќи проверката е задолжителна и заедничка. Стрелката оди од базниот кон вклучениот use case.&lt;/p&gt;&lt;p style=&quot;margin:2px 0 6px 0;text-align:left&quot;&gt;&lt;strong&gt;«extend»:&lt;/strong&gt; Calculate Fine → Return Book, бидејќи казната се пресметува само при задоцнување. Стрелката оди од проширувањето кон базниот use case.&lt;/p&gt;&lt;p style=&quot;margin:2px 0 6px 0;text-align:left&quot;&gt;Reserve Book → E-mail Service: стрелка кон секундарниот актер (известување). „Manage Catalogue“ е еден овал наместо Add/Edit/Delete Book.&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="724" width="900" height="306" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="2135-53" name="P2 · Нарачка храна"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="929" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2135-1" value="P2 · Нарачка храна: актери-системи и «extend» за купон" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#142027;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1000" height="32" as="geometry"/></mxCell><mxCell id="2135-2" value="&lt;b&gt;Scenario:&lt;/b&gt; &lt;i&gt;FoodNow is an online food ordering platform. Customers browse restaurant menus, place orders and track their delivery. Every order is paid online through an external payment gateway. While placing an order, a customer may optionally apply a discount coupon. Restaurant staff accept incoming orders and update their menus. Couriers confirm when an order has been delivered.&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Task:&lt;/b&gt; &lt;i&gt;Draw a use case diagram for FoodNow. Identify primary and secondary actors and show «include» and «extend» relationships.&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="38" width="900" height="108" as="geometry"/></mxCell><mxCell id="2135-3" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=#dcefe9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="190" y="182" width="475" height="465" as="geometry"/></mxCell><mxCell id="2135-4" value="FoodNow Ordering System" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="329" y="191" width="197" height="18" as="geometry"/></mxCell><mxCell id="2135-5" value="" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="252" y="250" width="116" height="44" as="geometry"/></mxCell><mxCell id="2135-6" value="Browse Menu" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="264" y="264" width="93" height="16" as="geometry"/></mxCell><mxCell id="2135-7" value="" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="252" y="360" width="116" height="44" as="geometry"/></mxCell><mxCell id="2135-8" value="Place Order" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="264" y="374" width="93" height="16" as="geometry"/></mxCell><mxCell id="2135-9" value="" style="ellipse;whit