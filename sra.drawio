le=0;fontColor=#0b7a6b;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="401" y="250" width="73" height="15" as="geometry"/></mxCell><mxCell id="7417-48" value="" style="html=1;rounded=0;endFill=1;endArrow=block;endFill=1;endSize=8;startArrow=none;strokeColor=#142027;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="632.5" y="266.6" as="sourcePoint"/><mxPoint x="755.0" y="264.3" as="targetPoint"/></mxGeometry></mxCell><mxCell id="7417-49" value="" style="html=1;rounded=0;endFill=1;endArrow=open;endSize=8;startArrow=none;strokeColor=#142027;strokeWidth=1.5;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="482.2" y="378.0" as="sourcePoint"/><mxPoint x="399.4" y="372.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="7417-50" value="«extend»" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#0b7a6b;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="409" y="356" width="66" height="15" as="geometry"/></mxCell><mxCell id="7417-51" value="" style="html=1;rounded=0;endFill=1;endArrow=block;endFill=1;endSize=8;startArrow=none;strokeColor=#142027;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="755.0" y="533.9" as="sourcePoint"/><mxPoint x="620.0" y="509.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="7417-52" value="" style="html=1;rounded=0;endFill=1;endArrow=block;endFill=1;endSize=8;startArrow=none;strokeColor=#142027;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="755.0" y="542.3" as="sourcePoint"/><mxPoint x="618.2" y="584.9" as="targetPoint"/></mxGeometry></mxCell><mxCell id="7417-53" value="&lt;div style=&quot;font-weight:bold;font-size:14px;margin:6px 0 2px 0;text-align:left&quot;&gt;Решение&lt;/div&gt;&lt;p style=&quot;margin:2px 0 6px 0;text-align:left&quot;&gt;Premium Member е поврзан со Member со &lt;strong&gt;генерализација&lt;/strong&gt; (полна линија, празен триаголник кон Member). Затоа ги наследува Buy or Renew Membership, Book Group Class и View Workout History, а директно е поврзан само со Book Personal Session.&lt;/p&gt;&lt;p style=&quot;margin:2px 0 6px 0;text-align:left&quot;&gt;Buy or Renew Membership «include» Process Payment → Payment System (секундарен актер). Join Waiting List «extend» Book Group Class. Trainer: Publish Class Schedule и Confirm Personal Session.&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="693" width="900" height="177" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="8175-52" name="P5 · Паркинг"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="919" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="8175-1" value="P5 · Паркинг: хардверски уред како актер" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#142027;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1000" height="32" as="geometry"/></mxCell><mxCell id="8175-2" value="&lt;b&gt;Scenario:&lt;/b&gt; &lt;i&gt;A city builds a Smart Parking System. Drivers find a free parking space and can reserve it; both features always check live space availability. Drivers pay for parking through an external payment provider and, while paying, may extend their parking time. Parking sensors in each space send occupancy updates to the system. City administrators view occupancy analytics.&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Task:&lt;/b&gt; &lt;i&gt;Draw a use case diagram for the Smart Parking System. Make sure non-human actors are shown correctly.&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="38" width="900" height="108" as="geometry"/></mxCell><mxCell id="8175-3" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=#dcefe9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="195" y="182" width="475" height="455" as="geometry"/></mxCell><mxCell id="8175-4" value="Smart Parking System" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="346" y="191" width="172" height="18" as="geometry"/></mxCell><mxCell id="8175-5" value="" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="242" y="220" width="145" height="44" as="geometry"/></mxCell><mxCell id="8175-6" value="Find Free Space" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="253" y="234" width="123" height="16" as="geometry"/></mxCell><mxCell id="8175-7" value="" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="250" y="320" width="131" height="44" as="geometry"/></mxCell><mxCell id="8175-8" value="Reserve Space" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="261" y="334" width="108" height="16" as="geometry"/></mxCell><mxCell id="8175-9" value="" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="242" y="425" width="145" height="44" as="geometry"/></mxCell><mxCell id="8175-10" value="Pay for Parking" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=0;fontColor=#142027;spacing=0;spacingLe