elative="1" as="geometry"><mxPoint x="605.0" y="571.0" as="sourcePoint"/><mxPoint x="605.0" y="605.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="7895-51" value="Yes" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="611" y="580" width="31" height="15" as="geometry"/></mxCell><mxCell id="7895-52" value="" style="html=1;rounded=0;endFill=1;endArrow=block;endFill=1;endSize=8;startArrow=none;strokeColor=#142027;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="605.0" y="641.0" as="sourcePoint"/><mxPoint x="605.0" y="675.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="7895-53" value="" style="html=1;rounded=0;endFill=1;endArrow=block;endFill=1;endSize=8;startArrow=none;strokeColor=#142027;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520.0" y="693.0" as="sourcePoint"/><mxPoint x="205.0" y="693.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="7895-54" value="" style="html=1;rounded=0;endFill=1;endArrow=block;endFill=1;endSize=8;startArrow=none;strokeColor=#142027;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="145.0" y="711.0" as="sourcePoint"/><mxPoint x="145.0" y="737.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="7895-55" value="&lt;div style=&quot;font-weight:bold;font-size:14px;margin:6px 0 2px 0;text-align:left&quot;&gt;Решение&lt;/div&gt;&lt;p style=&quot;margin:2px 0 6px 0;text-align:left&quot;&gt;Ленти: Patient, Receptionist, Hospital System. Тек: Call hospital → Ask for patient ID → Search patient record → &lt;em&gt;Registered?&lt;/em&gt; (No → Register patient) → Find free slots → &lt;em&gt;Slot free?&lt;/em&gt; (No → Offer another date → назад на Find free slots) → Save appointment → Send SMS confirmation → Receive SMS → крај.&lt;/p&gt;&lt;p style=&quot;margin:2px 0 6px 0;text-align:left&quot;&gt;Секоја гранка на ромбот е означена, а секој чекор е глагол во лентата на тој што го извршува.&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="803" width="900" height="177" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="5520-34" name="P9 · Теретана"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="910" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="5520-1" value="P9 · Теретана: контекст дијаграм" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#142027;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1000" height="32" as="geometry"/></mxCell><mxCell id="5520-2" value="&lt;b&gt;Scenario:&lt;/b&gt; &lt;i&gt;Define the scope of the Gym Membership System. Members send registrations and class bookings and receive membership cards and booking confirmations. Trainers send class schedules and receive attendee lists. The gym manager receives membership reports. An external payment system receives payment requests and returns payment results. The access gate at the entrance sends card scans and receives open or deny signals.&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Task:&lt;/b&gt; &lt;i&gt;Draw a context diagram for the Gym Membership System.&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="38" width="900" height="129" as="geometry"/></mxCell><mxCell id="5520-3" value="" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=#dcefe9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="355" y="333" width="170" height="170" as="geometry"/></mxCell><mxCell id="5520-4" value="Gym Membership&lt;br&gt;System" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="378" y="401" width="124" height="34" as="geometry"/></mxCell><mxCell id="5520-5" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="70" y="397" width="120" height="42" as="geometry"/></mxCell><mxCell id="5520-6" value="Member" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="102" y="410" width="55" height="16" as="geometry"/></mxCell><mxCell id="5520-7" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="675" y="397" width="150" height="42" as="geometry"/></mxCell><mxCell id="5520-8" value="Payment System" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="692" y="410" width="116" height="16" as="geometry"/></mxCell><mxCell id="5520-9" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="202" width="120" height="42" as="geometry"/></mxCell><mxCell id="5520-10" value="Trainer" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="409" y="215" width="63" height="16" as="geometry"/></mxCell><mxCell id="5520-11" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="100" y="587" width="140" height="42" as="geometry"/></mxCell><mxCell id="5520-12" value="Gym Manager" style="text;html=1;a