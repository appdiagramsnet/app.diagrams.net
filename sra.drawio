<mxfile host="app.diagrams.net"><diagram id="7024-42" name="1 · Use case diagram"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="989" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="7024-1" value="1 · Use case diagram" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#142027;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="900" height="34" as="geometry"/></mxCell><mxCell id="7024-2" value="&lt;span style=&#x27;color:#5b6b73&#x27;&gt;Use case дијаграм (дијаграм на случаи на употреба)&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="32" width="900" height="41" as="geometry"/></mxCell><mxCell id="7024-3" value="&lt;b&gt;Scenario:&lt;/b&gt; &lt;i&gt;Room Booking System (Exercise 4): students view room availability, book rooms and cancel their bookings. Some rooms require administrator approval before a booking is confirmed. The system notifies users about every booking change. Administrators approve bookings and generate usage reports.&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="73" width="900" height="87" as="geometry"/></mxCell><mxCell id="7024-4" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=#dcefe9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="190" y="196" width="475" height="445" as="geometry"/></mxCell><mxCell id="7024-5" value="Room Booking System" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="345" y="205" width="164" height="18" as="geometry"/></mxCell><mxCell id="7024-6" value="" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="238" y="249" width="160" height="44" as="geometry"/></mxCell><mxCell id="7024-7" value="View Availability" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="249" y="263" width="138" height="16" as="geometry"/></mxCell><mxCell id="7024-8" value="" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="266" y="359" width="104" height="44" as="geometry"/></mxCell><mxCell id="7024-9" value="Book Room" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="279" y="373" width="78" height="16" as="geometry"/></mxCell><mxCell id="7024-10" value="" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="249" y="484" width="138" height="44" as="geometry"/></mxCell><mxCell id="7024-11" value="Cancel Booking" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="260" y="498" width="116" height="16" as="geometry"/></mxCell><mxCell id="7024-12" value="" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="474" y="254" width="152" height="44" as="geometry"/></mxCell><mxCell id="7024-13" value="Request Approval" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="485" y="268" width="131" height="16" as="geometry"/></mxCell><mxCell i