"16" as="geometry"/></mxCell><mxCell id="7336-38" value="R" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="376" y="260" width="18" height="16" as="geometry"/></mxCell><mxCell id="7336-39" value="R" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="458" y="260" width="18" height="16" as="geometry"/></mxCell><mxCell id="7336-40" value="Approval" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="58" y="292" width="70" height="16" as="geometry"/></mxCell><mxCell id="7336-41" value="C" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="458" y="292" width="18" height="16" as="geometry"/></mxCell><mxCell id="7336-42" value="R" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="540" y="292" width="18" height="16" as="geometry"/></mxCell><mxCell id="7336-43" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=none;strokeWidth=1.4;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="593" y="147" width="104" height="166" as="geometry"/></mxCell><mxCell id="7336-44" value="&lt;p style=&quot;margin:2px 0 6px 0;text-align:left&quot;&gt;Booking има C (Book Room), R, U (Approve) и D (Cancel), како во E4 sol p.4. &lt;strong&gt;Room нема C, U ни D&lt;/strong&gt;: никој не додава, менува или брише простории. Затоа недостасува use case „Manage Rooms“ за администраторот (испрекинатата колона). Ова е намената на CRUD матрицата (L4 script p.7).&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="346" width="900" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="1229-52" name="P1 · Библиотека"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1090" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="1229-1" value="P1 · Библиотека: use case дијаграм со «include» и «extend»" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#142027;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1000" height="32" as="geometry"/></mxCell><mxCell id="1229-2" value="&lt;b&gt;Scenario:&lt;/b&gt; &lt;i&gt;A city library wants a Library Management System. Members search the catalogue, reserve books and renew their loans online. A member&amp;#x27;s account (membership valid, no blocks) must always be verified before a reservation, a renewal or a checkout. Librarians check out books, process returns and manage the catalogue. When a book is returned late, the system calculates a fine. When a reserved book becomes available, the system notifies the member through an external e-mail service.&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Task:&lt;/b&gt; &lt;i&gt;Draw a use case diagram for the Library Management System. Show the system boundary, all actors, the main use cases, and use «include» and «extend» where appropriate.&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="38" width="900" height="150" as="geometry"/></mxCell><mxCell id="1229-3" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=#dcefe9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="190" y="224" width="480" height="465" as="geometry"/></mxCell><mxCell id="1229-4" value="Library Management System" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="324" y="233" width="213" height="18" as="geometry"/></mxCell><mxCell id="1229-5" value="" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="236" y="257" width="152" height="44" as="geometry"/></mxCell><mxCell id="1229-6" value="Search Catalogue" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="247" y="271" width="131" height="16" as="geometry"/></mxCell><mxCell id="1229-7" value="" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="250" y="327" width="123" height="44" as="geometry"/></mxCell><mxCell id="1229-8" value="Reserve Book" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="262" y="341" width="100" height="16" as="geometry"/></mxCell><mxCell id="1229-9" value="" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="258" y="397" width="109" height="44" as="geometry"/></mxCell><mxCell id="1229-10" value="Renew Loan" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="269" y="411" width="85" height="16" as="geometry"/></mxCell><mxCell id="1229-11" value="" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="243" y="48