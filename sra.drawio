7" value="StudentID (FK)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="368" y="291" width="116" height="16" as="geometry"/></mxCell><mxCell id="2084-18" value="RoomID (FK)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="368" y="311" width="93" height="16" as="geometry"/></mxCell><mxCell id="2084-19" value="AdminID (FK)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="368" y="331" width="100" height="16" as="geometry"/></mxCell><mxCell id="2084-20" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=#dcefe9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="670" y="215" width="170" height="30" as="geometry"/></mxCell><mxCell id="2084-21" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="670" y="215" width="170" height="98" as="geometry"/></mxCell><mxCell id="2084-22" value="Room" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="734" y="221" width="42" height="18" as="geometry"/></mxCell><mxCell id="2084-23" value="RoomID (PK)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="678" y="251" width="93" height="16" as="geometry"/></mxCell><mxCell id="2084-24" value="Capacity" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="678" y="271" width="70" height="16" as="geometry"/></mxCell><mxCell id="2084-25" value="Type" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="678" y="291" width="40" height="16" as="geometry"/></mxCell><mxCell id="2084-26" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=#dcefe9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="360" y="417" width="180" height="30" as="geometry"/></mxCell><mxCell id="2084-27" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="360" y="417" width="180" height="78" as="geometry"/></mxCell><mxCell id="2084-28" value="Administrator" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="392" y="423" width="116" height="18" as="geometry"/></mxCell><mxCell id="2084-29" value="AdminID (PK)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="368" y="453" width="100" height="16" as="geometry"/></mxCell><mxCell id="2084-30" value="Name" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="368" y="473" width="40" height="16" as="geometry"/></mxCell><mxCell id="2084-31" value="" style="html=1;rounded=0;endFill=1;endArrow=none;startArrow=none;strokeColor=#142027;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="230.0" y="264.8" as="sourcePoint"/><mxPoint x="360.0" y="264.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="2084-32" value="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#0b7a6b;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="237" y="246" width="18" height="18" as="geometry"/></mxCell><mxCell id="2084-33" value="*" style="text;html=1;align=center;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#0b7a6b;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="334" y="247" width="20" height="21" as="geometry"/></mxCell><mxCell id="2084-34" value="makes" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="273" y="273" width="45" height="15" as="geometry"/></mxCell><mxCell id="2084-35" value="" style="html=1;rounded=0;endFill=1;endArrow=none;startArrow=none;strokeColor=#142027;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="670.0" y="264.8" as="sourcePoint"/><mxPoint x="540.0" y="264.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="2084-36" value="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#0b7a6b;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="645" y="246" width="18" height="18" as="geometry"/></mxCell><mxCell id="2084-37" value="*" style="text;html=1;align=center;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#0b7a6b;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="546" y="247" width="20" height="21" as="geometry"/></mxCell><mxCell id="2084-38" value="is booked in" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="558" y="273" width="94" height="15" as="geometry"/></mxCell><mxCell id="2084-39" value="" style="html=1;rounded=0;endFill=1;endArrow=none;startArrow=none;strokeColor=#142027;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450.0" y="416.8" as="sourcePoint"/><mxPoint x="450.0" y="352.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="2084-40" value="0..1" style="text;html=1;align=right;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#0b7a6b;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="402" y="392" width="42" height="18" as="geometry"/></mxCell><mxCell id="2084-41" value="*" style="text;html=1;align=right;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#0b7a6b;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="424" y="361" width="20" height="21" as="geometry"/></mxCell><mxCell id="2084-42" value="approves" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="458" y="377" width="66" height="15" as="geometry"/></mxCell><mxCell id="2084-43" value="&lt;p style=&quot;margin:2px 0 6px 0;text-align:left&quot;&gt;Ентитетите и атрибутите се од E4 sol p.4: Student(StudentID, Name, Email), Room(RoomID, Capacity, Type), Booking(BookingID, Date, Time, Status), со врски Student 1—* Booking и Room 1—* Booking.&lt;/p&gt;&lt;p style=&quot;margin:2px 0 6px 0;text-align:left&quot;&gt;Booking всушност ја &lt;strong&gt;разложува many-to-many врската&lt;/strong&gt; меѓу Student и Room (еден студент, многу простории, и обратно). Затоа Booking ги има двата FK.&lt;/p&gt;&lt;p style=&quot;margin:2px 0 6px 0;text-align:left&quot;&gt;Administrator е додаден од E4 sol p.4 (ентитети: Student, Room, Booking, Administrator, Approval) како едноставна врска 0..1—*: резервација што не бара одобрение нема администратор, затоа 0..1. Табела Approval е исто така точна варијанта.&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="525" width="900" height="195" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="5516-32" name="3 · State-transition diagram"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="609" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="5516-1" value="3 · State-transition diagram" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#142027;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="900" height="34" as="geometry"/></mxCell><mxCell id="5516-2" value="&lt;span style=&#x27;color:#5b6b73&#x27;&gt;Дијаграм на состојби (State-transition diagram, STD)&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="32" width="900" height="41" as="geometry"/></mxCell><mxCell id="5516-3" value="&lt;b&gt;Scenario:&lt;/b&gt; &lt;i&gt;Room Booking System (Exercise 4): a booking is Requested by a student; the administrator approves or rejects it; the student can cancel a requested or approved booking; an approved booking becomes Completed when the time slot ends.&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="73" width="900" height="66" as="geometry"/></mxCell><mxCell id="5516-4" value="" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=#142027;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="72" y="187" width="16" height="16" as="geometry"/></mxCell><mxCell id="5516-5" value="" style="rounded=1;absoluteArcSize=1;arcSize=28.0;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=#dcefe9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="130" y="173" width="140" height="44" as="geometry"/></mxCell><mxCell id="5516-6" value="Requested" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="161" y="187" width="78" height="16" as="geometry"/></mxCell><mxCell id="5516-7" value="" style="rounded=1;absoluteArcSize=1;arcSize=28.0;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=#dcefe9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="390" y="173" width="140" height="44" as="geometry"/></mxCell><mxCell id="5516-8" value="Approved" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="425" y="187" width="70" height="16" as="geometry"/></mxCell><mxCell id="5516-9" value="" style="rounded=1;absoluteArcSize=1;arcSize=28.0;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=#dcefe9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="640" y="173" width="140" height="44" as="geometry"/></mxCell><mxCell id="5516-10" value="Completed" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="671" y="187" width="78" height="16" as="geometry"/></mxCell><mxCell id="5516-11" value="" style="rounded=1;absoluteArcSize=1;arcSize=28.0;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=#dcefe9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="130" y="303" width="140" height="44" as="geometry"/></mxCell><mxCell id="5516-12" value="Rejected" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="165" y="317" width="70" height="16" as="geometry"/></mxCell><mxCell id="5516-13" value="" style="rounded=1;absoluteArcSize=1;arcSize=28.0;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=#dcefe9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="390" y="303" width="140" height="44" as="geometry"/></mxCell><mxCell id="5516-14" value="Cancelled" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="421" y="317" width="78" height="16" as="geometry"/></mxCell><mxCell id="5516-15" value="" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=none;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="698" y="313" width="24" height="24" as="geometry"/></mxCell><mxCell id="5516-16" value="" style="ellipse;whiteSpace=wrap;html=1;strokeColor=none;fillColor=#142027;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="703" y="318" width="14" height="14" as="geometry"/></mxCell><mxCell id="5516-17" value="" style="html=1;rounded=0;endFill=1;endArrow=block;endFill=1;endSize=8;startArrow=none;strokeColor=#142027;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="88.0" y="194.8" as="sourcePoint"/><mxPoint x="130.0" y="194.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="5516-18" value="" style="html=1;rounded=0;endFill=1;endArrow=block;endFill=1;endSize=8;startArrow=none;strokeColor=#142027;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270.0" y="194.8" as="sourcePoint"/><mxPoint x="390.0" y="194.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="5516-19" value="admin approves" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="276" y="174" width="107" height="15" as="geometry"/></mxCell><mxCell id="5516-20" value="" style="html=1;rounded=0;endFill=1;endArrow=block;endFill=1;endSize=8;startArrow=none;strokeColor=#142027;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="530.0" y="194.8" as="sourcePoint"/><mxPoint x="640.0" y="194.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="5516-21" value="time slot ends" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="531" y="174" width="107" height="15" as="geometry"/></mxCell><mxCell id="5516-22" value="" style="html=1;rounded=0;endFill=1;endArrow=block;endFill=1;endSize=8;startArrow=none;strokeColor=#142027;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="200.0" y="216.8" as="sourcePoint"/><mxPoint x="200.0" y="302.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="5516-23" value="admin rejects" style="text;html=1;align=right;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="92" y="252" width="100" height="15" as="geometry"/></mxCell><mxCell id="5516-24" value="" style="html=1;rounded=0;endFill=1;endArrow=block;endFill=1;endSize=8;startArrow=none;strokeColor=#142027;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460.0" y="216.8" as="sourcePoint"/><mxPoint x="460.0" y="302.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="5516-25" value="student cancels" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="466" y="252" width="114" height="15" as="geometry"/></mxCell><mxCell id="5516-26" value="" style="html=1;rounded=0;endFill=1;endArrow=block;endFill=1;endSize=8;startArrow=none;strokeColor=#142027;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="244.0" y="216.8" as="sourcePoint"/><mxPoint x="416.0" y="302.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="5516-27" value="student cancels" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="338" y="235" width="114" height="15" as="geometry"/></mxCell><mxCell id="5516-28" value="" style="html=1;rounded=0;endFill=1;endArrow=block;endFill=1;endSize=8;startArrow=none;strokeColor=#142027;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="530.0" y="324.8" as="sourcePoint"/><mxPoint x="698.0" y="324.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="5516-29" value="" style="html=1;rounded=0;endFill=1;endArrow=block;endFill=1;endSize=8;startArrow=none;strokeColor=#142027;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="710.0" y="216.8" as="sourcePoint"/><mxPoint x="710.0" y="312.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="5516-30" value="" style="html=1;rounded=0;endFill=1;endArrow=block;endFill=1;endSize=8;startArrow=none;strokeColor=#142027;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="200.0" y="346.8" as="sourcePoint"/><mxPoint x="710.0" y="336.8" as="targetPoint"/><Array as="points"><mxPoint x="200.0" y="382.8"/><mxPoint x="710.0" y="382.8"/></Array></mxGeometry></mxCell><mxCell id="5516-31" value="&lt;p style=&quot;margin:2px 0 6px 0;text-align:left&quot;&gt;Статусите се точно оние од E4 sol p.3: Requested, Approved, Rejected, Cancelled, Completed. Секоја стрелка е означена со &lt;strong&gt;настан&lt;/strong&gt; („admin approves“), а не со улога.&lt;/p&gt;&lt;p style=&quot;margin:2px 0 6px 0;text-align:left&quot;&gt;„student cancels“ се појавува двапати, бидејќи откажувањето е можно од две состојби. Rejected, Cancelled и Completed се крајни, па сите водат кон bullseye.&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="415" width="900" height="135" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="6386-48" name="4 · Swimlane diagram / activity diagram"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="770" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="6386-1" value="4 · Swimlane diagram / activity diagram" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#142027;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="900" height="34" as="geometry"/></mxCell><mxCell id="6386-2" value="&lt;span style=&#x27;color:#5b6b73&#x27;&gt;Swimlane дијаграм / дијаграм на активности (activity diagram)&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="32" width="900" height="41" as="geometry"/></mxCell><mxCell id="6386-3" value="&lt;b&gt;Scenario:&lt;/b&gt; &lt;i&gt;Room Booking System (Exercise 4): a student requests a booking; the system checks availability; if the room is not free the student chooses another time; if the room needs approval the administrator approves the request; the system confirms the booking and the student gets a confirmation.&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="73" width="900" height="87" as="geometry"/></mxCell><mxCell id="6386-4" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="50" y="186" width="830" height="110" as="geometry"/></mxCell><mxCell id="6386-5" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=#dcefe9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="50" y="186" width="100" height="110" as="geometry"/></mxCell><mxCell id="6386-6" value="Student" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#142027;spacing=0;spacingLeft=2;spacingRi