 relative="1" as="geometry"><mxPoint x="513.3" y="260.9" as="sourcePoint"/><mxPoint x="341.2" y="363.4" as="targetPoint"/></mxGeometry></mxCell><mxCell id="2135-45" value="«extend»" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#0b7a6b;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="383" y="285" width="66" height="15" as="geometry"/></mxCell><mxCell id="2135-46" value="" style="html=1;rounded=0;endFill=1;endArrow=open;endSize=8;startArrow=none;strokeColor=#142027;strokeWidth=1.5;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="361.8" y="372.1" as="sourcePoint"/><mxPoint x="495.8" y="346.4" as="targetPoint"/></mxGeometry></mxCell><mxCell id="2135-47" value="«include»" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#0b7a6b;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="395" y="367" width="73" height="15" as="geometry"/></mxCell><mxCell id="2135-48" value="" style="html=1;rounded=0;endFill=1;endArrow=block;endFill=1;endSize=8;startArrow=none;strokeColor=#142027;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="599.4" y="336.8" as="sourcePoint"/><mxPoint x="751.0" y="336.1" as="targetPoint"/></mxGeometry></mxCell><mxCell id="2135-49" value="" style="html=1;rounded=0;endFill=1;endArrow=block;endFill=1;endSize=8;startArrow=none;strokeColor=#142027;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="751.0" y="463.0" as="sourcePoint"/><mxPoint x="600.4" y="436.7" as="targetPoint"/></mxGeometry></mxCell><mxCell id="2135-50" value="" style="html=1;rounded=0;endFill=1;endArrow=block;endFill=1;endSize=8;startArrow=none;strokeColor=#142027;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="751.0" y="469.1" as="sourcePoint"/><mxPoint x="597.2" y="497.4" as="targetPoint"/></mxGeometry></mxCell><mxCell id="2135-51" value="" style="html=1;rounded=0;endFill=1;endArrow=block;endFill=1;endSize=8;startArrow=none;strokeColor=#142027;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="751.0" y="591.1" as="sourcePoint"/><mxPoint x="621.2" y="591.7" as="targetPoint"/></mxGeometry></mxCell><mxCell id="2135-52" value="&lt;div style=&quot;font-weight:bold;font-size:14px;margin:6px 0 2px 0;text-align:left&quot;&gt;Решение&lt;/div&gt;&lt;p style=&quot;margin:2px 0 6px 0;text-align:left&quot;&gt;&lt;strong&gt;Примарни актери:&lt;/strong&gt; Customer, Restaurant Staff, Courier. &lt;strong&gt;Секундарен:&lt;/strong&gt; Payment Gateway (надворешен систем; стрелката оди од Pay Online кон него).&lt;/p&gt;&lt;p style=&quot;margin:2px 0 6px 0;text-align:left&quot;&gt;Place Order «include» Pay Online, бидејќи секоја нарачка се плаќа. Apply Coupon «extend» Place Order, бидејќи купонот е опционален.&lt;/p&gt;&lt;p style=&quot;margin:2px 0 6px 0;text-align:left&quot;&gt;Честа грешка: „Payment“ нацртано како овал без актер, или Payment Gateway внатре во границата.&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="682" width="900" height="187" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="5646-54" name="P3 · Болница"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="920" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="5646-1" value="P3 · Болница: заеднички use case-и за двајца актери" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#142027;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1000" height="32" as="geometry"/></mxCell><mxCell id="5646-2" value="&lt;b&gt;Scenario:&lt;/b&gt; &lt;i&gt;A hospital needs an appointment system. Patients register online and book or cancel appointments. Receptionists can also book and cancel appointments for patients who call by phone. Whenever an appointment is booked or cancelled, the system sends an SMS to the patient through an external SMS gateway. If no slot is free, a patient may join a waiting list for that doctor. Doctors view their daily schedule and record visit notes.&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Task:&lt;/b&gt; &lt;i&gt;Draw a use case diagram for the hospital appointment system.&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="38" width="900" height="129" as="geometry"/></mxCell><mxCell id="5646-3" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=#dcefe9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="190" y="203" width="480" height="445" as="geometry"/></mxCell><mxCell id="5646-4" value="Hospital Appointment System" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="315" y="212" width="229" height="18" as="geometry"/></mxCell><mxCell id="5646-5" value="" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="260" y="236" width="104" height="44" as="geometry"/></mxCell><mxCell id="5646-6" value="Register" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="277" y="250" width="70" height="16" as="geometry"/></mxCell><mxCell id="5646-7" value="" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="236" y="336" width="152" height="44" as="geometry"/></mxCell><mxCell id="5646-8" value="Book Appointment" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="247" y="350" width="131" height="16" as="geometry"/></mxCell><mxCell id="5646-9" value="" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="254" y="440" width="116" height="56" as="geometry"/></mxCell><mxCell id="5646-10" value="Cancel&lt;br&gt;Appointment" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="266" y="452" width="93" height="32" as="geometry"/></mxCell><mxCell id="5646-11" value="" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="470" y="246" width="160" height="44" as="geometry"/></mxCell><mxCell id="5646-12" value="Join Waiting List" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="481" y="260" width="138" height="16" as="geometry"/></mxCell><mxCell id="5646-13" value="" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="483" y="380" width="123" height="56" as="geometry"/></mxCell><mxCell id="5646-14" value="Send SMS&lt;br&gt;Notification" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=0;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="495" y="392" width="100" height="32" as="geometry"/></mxCell><mxCell id="5646-15" value="" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="496" y="485" width="109" height="56" as="