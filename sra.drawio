ntStyle=0;fontColor=#0b7a6b;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="395" y="448" width="73" height="15" as="geometry"/></mxCell><mxCell id="5646-50" value="" style="html=1;rounded=0;endFill=1;endArrow=block;endFill=1;endSize=8;startArrow=none;strokeColor=#142027;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="606.7" y="407.7" as="sourcePoint"/><mxPoint x="751.0" y="407.1" as="targetPoint"/></mxGeometry></mxCell><mxCell id="5646-51" value="" style="html=1;rounded=0;endFill=1;endArrow=block;endFill=1;endSize=8;startArrow=none;strokeColor=#142027;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="751.0" y="553.6" as="sourcePoint"/><mxPoint x="600.6" y="523.2" as="targetPoint"/></mxGeometry></mxCell><mxCell id="5646-52" value="" style="html=1;rounded=0;endFill=1;endArrow=block;endFill=1;endSize=8;startArrow=none;strokeColor=#142027;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="751.0" y="560.6" as="sourcePoint"/><mxPoint x="603.2" y="591.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="5646-53" value="&lt;div style=&quot;font-weight:bold;font-size:14px;margin:6px 0 2px 0;text-align:left&quot;&gt;Решение&lt;/div&gt;&lt;p style=&quot;margin:2px 0 6px 0;text-align:left&quot;&gt;Patient и Receptionist се поврзани со истите овали Book Appointment и Cancel Appointment. Не се црта посебен „Book by Phone“, бидејќи целта е иста.&lt;/p&gt;&lt;p style=&quot;margin:2px 0 6px 0;text-align:left&quot;&gt;Book и Cancel «include» Send SMS Notification, а тој use case е поврзан со секундарниот актер SMS Gateway. Join Waiting List «extend» Book Appointment. Doctor е десно, со своите два use case-и.&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="683" width="900" height="177" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="7417-54" name="P4 · Теретана"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="930" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="7417-1" value="P4 · Теретана: генерализација на актери" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#142027;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1000" height="32" as="geometry"/></mxCell><mxCell id="7417-2" value="&lt;b&gt;Scenario:&lt;/b&gt; &lt;i&gt;A gym introduces a membership system. Members buy or renew their membership, book group classes and view their workout history. Every purchase or renewal is processed by an external payment system. If a group class is full, the member may join its waiting list. Premium members can do everything regular members can, and can also book personal training sessions. Trainers publish the class schedule and confirm personal sessions.&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Task:&lt;/b&gt; &lt;i&gt;Draw a use case diagram for the gym membership system, including actor generalization.&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="38" width="900" height="129" as="geometry"/></mxCell><mxCell id="7417-3" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#142027;fillColor=#dcefe9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="200" y="203" width="475" height="455" as="geometry"/></mxCell><mxCell id="7417-4" value="Gym Membership System" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#142027;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="347" y="212" width="181" height="18" as="geometry"/></mxCell><mxCell id="7417-5" value="" style="ellipse