yle=&quot;padding:2px 8px;white-space:nowrap;border-top:1px solid #e3e8e5&quot;&gt;&lt;u&gt;&lt;b&gt;BranchID&lt;/b&gt;&lt;/u&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 8px;color:#5b6b73;border-top:1px solid #e3e8e5&quot;&gt;INT&lt;/td&gt;&lt;td style=&quot;padding:2px 8px;color:#0b7a6b;font-weight:bold;border-top:1px solid #e3e8e5&quot;&gt;PK&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 8px;white-space:nowrap;border-top:1px solid #e3e8e5&quot;&gt;Zone&lt;/td&gt;&lt;td style=&quot;padding:2px 8px;color:#5b6b73;border-top:1px solid #e3e8e5&quot;&gt;NVARCHAR(50)&lt;/td&gt;&lt;td style=&quot;padding:2px 8px;color:#0b7a6b;font-weight:bold;border-top:1px solid #e3e8e5&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;overflow=fill;fillColor=#ffffff;strokeColor=#142027;verticalAlign=top;align=left;spacing=0;" vertex="1" parent="1"><mxGeometry x="787" y="1176" width="214" height="66" as="geometry"/></mxCell><mxCell id="5690-38" value="No_vehicle" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#0b7a6b;fontSize=10;fontColor=#0b7a6b;" edge="1" parent="1" source="5690-36" target="5690-35"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="5690-39" value="BranchID" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#0b7a6b;fontSize=10;fontColor=#0b7a6b;" edge="1" parent="1" source="5690-36" target="5690-37"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="5690-40" value="3 instances per table" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#142027;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1294" width="700" height="30" as="geometry"/></mxCell><mxCell id="5690-41" value="&lt;b&gt;TAXI&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="1330" width="306" height="41" as="geometry"/></mxCell><mxCell id="5690-42" value="&lt;table style=&quot;border-collapse:collapse;font-size:11px;width:100%&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;No_vehicle&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;Driver&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;Registration&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Petar Nikolov&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;SK-1234-AB&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;2&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Jovan Ristov&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;SK-5678-CD&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;3&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Marija Kostova&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;BT-9012-EF&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="1367" width="306" height="86" as="geometry"/></mxCell><mxCell id="5690-43" value="&lt;b&gt;TAXI_BRANCH&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="366" y="1330" width="160" height="41" as="geometry"/></mxCell><mxCell id="5690-44" value="&lt;table style=&quot;border-collapse:collapse;font-size:11px;width:100%&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;BranchID&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;Zone&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Centar&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;2&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Karposh&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;3&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Aerodrom&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;spacing=0;" vertex="1" parent="1"><mxGeometry x="366" y="1367" width="151" height="86" as="geometry"/></mxCell><mxCell id="5690-45" value="&lt;b&gt;DRIVING&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="537" y="1330" width="412" height="41" as="geometry"/></mxCell><mxCell id="5690-46" value="&lt;table style=&quot;border-collapse:collapse;font-size:11px;width:100%&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;No_vehicle&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;BranchID&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;DriveTime&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;Destination&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;2026-11-03 08:15&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;City Mall&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;2&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;2026-11-03 09:40&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Airport Skopje&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;3&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;2026-11-03 12:05&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Railway Station&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;spacing=0;" vertex="1" parent="1"><mxGeometry x="537" y="1367" width="412" height="86" as="geometry"/></mxCell><mxCell id="5690-47" value="DDL and INSERT (tested in SQL Server)" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#142027;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1477" width="700" height="30" as="geometry"/></mxCell><mxCell id="5690-48" value="&lt;pre style=&quot;margin:0;font-family:Courier New,monospace;font-size:12px;line-height:15px;text-align:left;white-space:pre&quot;&gt;CREATE TABLE TAXI (&#xa;  No_vehicle   INT           NOT NULL PRIMARY KEY,&#xa;  Driver       NVARCHAR(100) NOT NULL,&#xa;  Registration NVARCHAR(15)  NOT NULL UNIQUE&#xa;);&#xa;CREATE TABLE TAXI_BRANCH (&#xa;  BranchID INT          NOT NULL PRIMARY KEY,&#xa;  Zone     NVARCHAR(50) NOT NULL&#xa;);&#xa;CREATE TABLE DRIVING (&#xa;  No_vehicle  INT           NOT NULL REFERENCES TAXI(No_vehicle),&#xa;  BranchID    INT           NOT NULL REFERENCES TAXI_BRANCH(BranchID),&#xa;  DriveTime   DATETIME      NOT NULL,&#xa;  Destination NVARCHAR(100) NOT NULL,&#xa;  PRIMARY KEY (No_vehicle, BranchID, DriveTime)&#xa;);&#xa;&#xa;-- 1) independent tables first&#xa;INSERT INTO TAXI (No_vehicle, Driver, Registration) VALUES&#xa;  (1, &amp;#x27;Petar Nikolov&amp;#x27;,  &amp;#x27;SK-1234-AB&amp;#x27;),&#xa;  (2, &amp;#x27;Jovan Ristov&amp;#x27;,   &amp;#x27;SK-5678-CD&amp;#x27;),&#xa;  (3, &amp;#x27;Marija Kostova&amp;#x27;, &amp;#x27;BT-9012-EF&amp;#x27;);&#xa;INSERT INTO TAXI_BRANCH (BranchID, Zone) VALUES&#xa;  (1, &amp;#x27;Centar&amp;#x27;),&#xa;  (2, &amp;#x27;Karposh&amp;#x27;),&#xa;  (3, &amp;#x27;Aerodrom&amp;#x27;);&#xa;-- 2) then the relationship table (FKs must already exist)&#xa;INSERT INTO DRIVING (No_vehicle, BranchID, DriveTime, Destination) VALUES&#xa;  (1, 1, &amp;#x27;2026-11-03 08:15&amp;#x27;, &amp;#x27;City Mall&amp;#x27;),&#xa;  (2, 1, &amp;#x27;2026-11-03 09:40&amp;#x27;, &amp;#x27;Airport Skopje&amp;#x27;),&#xa;  (1, 3, &amp;#x27;2026-11-03 12:05&amp;#x27;, &amp;#x27;Railway Station&amp;#x27;);&#xa;&#xa;SELECT t.Driver, t.Registration, b.Zone, d.DriveTime, d.Destination&#xa;FROM DRIVING AS d&#xa;JOIN TAXI AS t        ON t.No_vehicle = d.No_vehicle&#xa;JOIN TAXI_BRANCH AS b ON b.BranchID = d.BranchID;&lt;/pre&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;spacingLeft=10;spacingTop=6;fontColor=#142027;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="40" y="1513" width="553" height="560" as="geometry"/></mxCell><mxCell id="5690-49" value="&lt;b&gt;Result of the SELECT&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="2087" width="553" height="41" as="geometry"/></mxCell><mxCell id="5690-50" value="&lt;table style=&quot;border-collapse:collapse;font-size:11px;width:100%&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;Driver&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;Registration&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;Zone&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;DriveTime&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;Destination&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Petar Nikolov&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;SK-1234-AB&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Centar&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;2026-11-03T08:15:00&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;City Mall&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Petar Nikolov&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;SK-1234-AB&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Aerodrom&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;2026-11-03T12:05:00&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Railway Station&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Jovan Ristov&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;SK-5678-CD&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Centar&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;2026-11-03T09:40:00&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Airport Skopje&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="2124" width="553" height="86" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>