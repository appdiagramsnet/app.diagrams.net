<mxfile host="app.diagrams.net"><diagram id="5690-51" name="2 · Table model (Taxi)"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="2269" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="5690-1" value="2 · Table model from ER (Taxi)   [10 points]" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#142027;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1000" height="36" as="geometry"/></mxCell><mxCell id="5690-2" value="&lt;i&gt;Use the given ER Diagram and create ER model (table model) for the database. Then, write the instance plan, i.e. how you will initially insert data … (if you can&#x27;t find any ER diagram attribute that can be defined as primary key, create your own). Write 3 instance/example for each Entity or Relation with info for data type, size, mandatory or not.&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f6f8f7;strokeColor=#d5dcd8;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="900" height="87" as="geometry"/></mxCell><mxCell id="5690-3" value="TAXI" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#142027;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="247" width="140" height="44" as="geometry"/></mxCell><mxCell id="5690-4" value="TAXI_BRANCH" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#142027;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="570" y="247" width="160" height="44" as="geometry"/></mxCell><mxCell id="5690-5" value="driving" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dcefe9;strokeColor=#0b7a6b;fontSize=13;" vertex="1" parent="1"><mxGeometry x="320" y="237" width="120" height="64" as="geometry"/></mxCell><mxCell id="5690-6" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#142027;" edge="1" parent="1" source="5690-3" target="5690-5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="5690-7" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#142027;" edge="1" parent="1" source="5690-5" target="5690-4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="5690-8" value="M" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontColor=#0b7a6b;fontSize=14;" vertex="1" parent="1"><mxGeometry x="190" y="247" width="20" height="20" as="geometry"/></mxCell><mxCell id="5690-9" value="N" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontColor=#0b7a6b;fontSize=14;" vertex="1" parent="1"><mxGeometry x="545" y="247" width="20" height="20" as="geometry"/></mxCell><mxCell id="5690-10" value="No_vehicle" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#142027;fontSize=12;fontStyle=5;" vertex="1" parent="1"><mxGeometry x="5" y="167" width="100" height="34" as="geometry"/></mxCell><mxCell id="5690-11" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#142027;" edge="1" parent="1" source="5690-3" target="5690-10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="5690-12" value="driver" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#142027;fontSize=12;" vertex="1" parent="1"><mxGeometry x="124" y="162" width="72" height="34" as="geometry"/></mxCell><mxCell id="5690-13" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#142027;" edge="1" parent="1" source="5690-3" target="5690-12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="5690-14" value="registration" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#142027;fontSize=12;" vertex="1" parent="1"><mxGeometry x="58" y="337" width="104" height="34" as="geometry"/></mxCell><mxCell id="5690-15" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#142027;" edge="1" parent="1" source="5690-3" target="5690-14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="5690-16" value="time" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#142027;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="162" width="60" height="34" as="geometry"/></mxCell><mxCell id="5690-17" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#142027;" edge="1" parent="1" source="5690-5" target="5690-16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="5690-18" value="destination" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#142027;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="337" width="100" height="34" as="geometry"/></mxCell><mxCell id="5690-19" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#142027;" edge="1" parent="1" source="5690-5" target="5690-18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="5690-20" value="BranchID" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0b7a6b;fontSize=12;fontStyle=5;dashed=1;" vertex="1" parent="1"><mxGeometry x="606" y="162" width="88" height="34" as="geometry"/></mxCell><mxCell id="5690-21" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#142027;" edge="1" parent="1" source="5690-4" target="5690-20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="5690-22" value="zone" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#142027;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="337" width="60" height="34" as="geometry"/></mxCell><mxCell id="5690-23" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#142027;" edge="1" parent="1" source="5690-4" target="5690-22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="5690-24" value="&lt;span style=&quot;color:#5b6b73&quot;&gt;Given ER diagram. Dashed = key added by us (Taxi_branch has no key) · M:N means a separate table for the relationship&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="384" width="800" height="39" as="geometry"/></mxCell><mxCell id="5690-25" value="&lt;div style=&quot;font-weight:bold;font-size:14px;margin:6px 0 2px 0;text-align:left&quot;&gt;Mapping rules (ER → tables)&lt;/div&gt;&lt;ol style=&quot;margin:2px 0 6px 0;padding-left:20px;text-align:left&quot;&gt;&#xa;&lt;li style=&quot;margin:0 0 2px 0&quot;&gt;Every entity becomes a table: &lt;b&gt;TAXI&lt;/b&gt;, &lt;b&gt;TAXI_BRANCH&lt;/b&gt;.&lt;/li&gt;&#xa;&lt;li style=&quot;margin:0 0 2px 0&quot;&gt;&lt;b&gt;TAXI_BRANCH&lt;/b&gt; has no attribute that can be a primary key (only zone), so we create our own key &lt;b&gt;BranchID&lt;/b&gt;, as the task allows.&lt;/li&gt;&#xa;&lt;li style=&quot;margin:0 0 2px 0&quot;&gt;The &lt;b&gt;M:N&lt;/b&gt; relationship (driving) becomes a separate table &lt;b&gt;DRIVING&lt;/b&gt;. It holds the keys of both sides as foreign keys, plus the relationship attributes (time, destination).&lt;/li&gt;&#xa;&lt;li style=&quot;margin:0 0 2px 0&quot;&gt;The primary key of DRIVING is &lt;b&gt;(No_vehicle, BranchID, DriveTime)&lt;/b&gt;, because the same taxi can drive for the same branch many times at different times. A surrogate &lt;i&gt;DrivingID&lt;/i&gt; is also acceptable.&lt;/li&gt;&#xa;&lt;li style=&quot;margin:0 0 2px 0&quot;&gt;Naming: &lt;b&gt;time&lt;/b&gt; is a reserved word, so the column is &lt;b&gt;DriveTime&lt;/b&gt;. &quot;destinatio&quot; in the picture is a typo, so the column is &lt;b&gt;Destination&lt;/b&gt;.&lt;/li&gt;&lt;/ol&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="433" width="520" height="341" as="geometry"/></mxCell><mxCell id="5690-26" value="&lt;div style=&quot;font-weight:bold;font-size:14px;margin:6px 0 2px 0;text-align:left&quot;&gt;Instance plan (insert order)&lt;/div&gt;&lt;ol style=&quot;margin:2px 0 6px 0;padding-left:20px;text-align:left&quot;&gt;&#xa;&lt;li style=&quot;margin:0 0 2px 0&quot;&gt;First the independent tables: &lt;b&gt;TAXI&lt;/b&gt; and &lt;b&gt;TAXI_BRANCH&lt;/b&gt;, in any order.&lt;/li&gt;&#xa;&lt;li style=&quot;margin:0 0 2px 0&quot;&gt;Then &lt;b&gt;DRIVING&lt;/b&gt;, because its foreign keys require the taxi and the branch to already exist.&lt;/li&gt;&#xa;&lt;li style=&quot;margin:0 0 2px 0&quot;&gt;Deleting goes in reverse: first DRIVING, then TAXI and TAXI_BRANCH.&lt;/li&gt;&lt;/ol&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="580" y="433" width="360" height="217" as="geometry"/></mxCell><mxCell id="5690-27" value="Tables: data type, size, mandatory" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#142027;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="784" width="700" height="30" as="geometry"/></mxCell><mxCell id="5690-28" value="&lt;b&gt;TAXI&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="394" height="41" as="geometry"/></mxCell><mxCell id="5690-29" value="&lt;table style=&quot;border-collapse:collapse;font-size:12px;width:100%&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;Column&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;Data type&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;Size&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;Mandatory&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;Key&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;No_vehicle&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;INT&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;4 B&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;NOT NULL&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;PK&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Driver&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;NVARCHAR&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;100&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;NOT NULL&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Registration&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;NVARCHAR&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;15&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;NOT NULL&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;UNIQUE&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="856" width="394" height="90" as="geometry"/></mxCell><mxCell id="5690-30" value="&lt;b&gt;TAXI_BRANCH&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="464" y="820" width="394" height="41" as="geometry"/></mxCell><mxCell id="5690-31" value="&lt;table style=&quot;border-collapse:collapse;font-size:12px;width:100%&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;Column&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;Data type&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;Size&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;Mandatory&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;Key&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;BranchID&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;INT&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;4 B&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;NOT NULL&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;PK (added)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Zone&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;NVARCHAR&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;50&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;NOT NULL&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;spacing=0;" vertex="1" parent="1"><mxGeometry x="464" y="856" width="394" height="69" as="geometry"/></mxCell><mxCell id="5690-32" value="&lt;b&gt;DRIVING (M:N relationship)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#142027;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="958" width="490" height="41" as="geometry"/></mxCell><mxCell id="5690-33" value="&lt;table style=&quot;border-collapse:collapse;font-size:12px;width:100%&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;Column&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;Data type&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;Size&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;Mandatory&lt;/th&gt;&lt;th style=&quot;border:1px solid #d5dcd8;background:#eaf0ed;padding:2px 6px;text-align:left;white-space:nowrap&quot;&gt;Key&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;No_vehicle&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;INT&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;4 B&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;NOT NULL&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;PK, FK → TAXI&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;BranchID&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;INT&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;4 B&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;NOT NULL&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;PK, FK → TAXI_BRANCH&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;DriveTime&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;DATETIME&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;8 B&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;NOT NULL&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;PK&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;Destination&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;NVARCHAR&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;100&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;NOT NULL&lt;/td&gt;&lt;td style=&quot;border:1px solid #d5dcd8;padding:2px 6px;white-space:nowrap;&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="995" width="490" height="111" as="geometry"/></mxCell><mxCell id="5690-34" value="Relational model (arrow = FK → PK)" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#142027;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1130" width="700" height="30" as="geometry"/></mxCell><mxCell id="5690-35" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot;&gt;&lt;tr&gt;&lt;th colspan=&quot;3&quot; style=&quot;background:#0b7a6b;color:#fff;padding:4px;font-size:12px&quot;&gt;TAXI&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 8px;white-space:nowrap;border-top:1px solid #e3e8e5&quot;&gt;&lt;u&gt;&lt;b&gt;No_vehicle&lt;/b&gt;&lt;/u&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 8px;color:#5b6b73;border-top:1px solid #e3e8e5&quot;&gt;INT&lt;/td&gt;&lt;td style=&quot;padding:2px 8px;color:#0b7a6b;font-weight:bold;border-top:1px solid #e3e8e5&quot;&gt;PK&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 8px;white-space:nowrap;border-top:1px solid #e3e8e5&quot;&gt;Driver&lt;/td&gt;&lt;td style=&quot;padding:2px 8px;color:#5b6b73;border-top:1px solid #e3e8e5&quot;&gt;NVARCHAR(100)&lt;/td&gt;&lt;td style=&quot;padding:2px 8px;color:#0b7a6b;font-weight:bold;border-top:1px solid #e3e8e5&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 8px;white-space:nowrap;border-top:1px solid #e3e8e5&quot;&gt;Registration&lt;/td&gt;&lt;td style=&quot;padding:2px 8px;color:#5b6b73;border-top:1px solid #e3e8e5&quot;&gt;NVARCHAR(15)&lt;/td&gt;&lt;td style=&quot;padding:2px 8px;color:#0b7a6b;font-weight:bold;border-top:1px solid #e3e8e5&quot;&gt;UNIQUE&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;overflow=fill;fillColor=#ffffff;strokeColor=#142027;verticalAlign=top;align=left;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="1176" width="277" height="85" as="geometry"/></mxCell><mxCell id="5690-36" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot;&gt;&lt;tr&gt;&lt;th colspan=&quot;3&quot; style=&quot;background:#0b7a6b;color:#fff;padding:4px;font-size:12px&quot;&gt;DRIVING&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 8px;white-space:nowrap;borde